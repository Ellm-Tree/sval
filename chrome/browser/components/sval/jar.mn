# Everything Sval loads by URL at runtime: the chrome window's panel code, the
# worker, and the engine the worker imports. `.sys.mjs` modules are not here —
# they go through MOZ_SRC_FILES in moz.build and are imported as moz-src URLs.
browser.jar:
# Kit, Firefox's fox mascot, illustrates Firefox's own promos (settings' default
# browser card, the PDF default prompt). It is Mozilla's artwork, which Sval may
# not ship, so Sval's logo stands in.
% override chrome://global/skin/illustrations/kit-concerned.svg chrome://branding/content/about-logo.svg
% override chrome://global/skin/illustrations/kit-happy.svg chrome://branding/content/about-logo.svg
% override chrome://global/skin/illustrations/kit-in-circle.svg chrome://branding/content/about-logo.svg
# Firefox's logo glyphs: settings' About and Languages icons and the Sval View
# button take Sval's glyph; the window icon carrying Firefox's logo takes the
# plain window icon.
% override chrome://browser/skin/sidebar/firefox.svg chrome://browser/content/sval/sval-glyph.svg
% override chrome://browser/skin/firefox-view.svg chrome://browser/content/sval/sval-glyph.svg
% override chrome://browser/skin/window-firefox.svg chrome://browser/skin/window.svg
# Mozilla's illustrations that draw Firefox's fox or a Firefox or Mozilla
# product logo, wherever Sval still shows them, take a Lucide glyph for what the
# surface is about, or Sval's own mark. docs/firefox-assets.md lists every
# Firefox image Sval could show and what happens to each;
# test_sval_firefox_assets.js holds this list to it.
% override chrome://browser/skin/addons/extensions-panel-empty-illustration.svg chrome://browser/content/sval/illustrations/puzzle.svg
% override chrome://global/skin/illustrations/no-connection.svg chrome://browser/content/sval/illustrations/unplug.svg
% override chrome://global/skin/illustrations/security-error.svg chrome://browser/content/sval/illustrations/shield-alert.svg
% override chrome://browser/skin/trustpanel-graphic-enabled.svg chrome://browser/content/sval/illustrations/trustpanel-shield-check.svg
% override chrome://browser/skin/trustpanel-graphic-disabled.svg chrome://browser/content/sval/illustrations/trustpanel-shield-x.svg
% override chrome://browser/skin/trustpanel-graphic-warning.svg chrome://browser/content/sval/illustrations/trustpanel-shield-alert.svg
% override chrome://global/content/megalist/icons/cpm-fox-illustration.svg chrome://browser/content/sval/illustrations/key-round.svg
% override chrome://browser/content/logos/lockwise.svg chrome://browser/content/sval/illustrations/key-round.svg
% override chrome://browser/skin/preferences/fox-ai.svg chrome://browser/content/sval/illustrations/sparkles.svg
% override chrome://mozapps/skin/extensions/line.svg chrome://browser/content/sval/icons/badge-check.svg
% override chrome://browser/content/firefoxview/history-empty.svg chrome://browser/content/sval/illustrations/history.svg
% override chrome://browser/content/firefoxview/synced-tabs-empty.svg chrome://browser/content/sval/illustrations/monitor-smartphone.svg
% override chrome://browser/content/firefoxview/synced-tabs-error.svg chrome://browser/content/sval/illustrations/monitor-smartphone.svg
% override chrome://devtools/skin/images/fox-smiling.svg chrome://branding/content/about-logo.svg
% override chrome://devtools/skin/images/aboutdebugging-firefox-logo.svg chrome://browser/content/sval/sval-glyph.svg
% override chrome://devtools/skin/images/aboutdebugging-firefox-release.svg chrome://branding/content/about-logo.svg
% override chrome://devtools/skin/images/aboutdebugging-firefox-beta.svg chrome://branding/content/about-logo.svg
% override chrome://devtools/skin/images/aboutdebugging-firefox-aurora.svg chrome://branding/content/about-logo.svg
% override chrome://devtools/skin/images/aboutdebugging-firefox-nightly.svg chrome://branding/content/about-logo.svg
# A new profile starts with no bookmarks; see default-bookmarks.html.
% override chrome://browser/content/default-bookmarks.html chrome://browser/content/sval/default-bookmarks.html
# Extensions' bookmarks are Favorites: the bookmarks API over the engine's
# document (favorites-native spec §8), with Firefox's schema and permission.
% override chrome://browser/content/parent/ext-bookmarks.js chrome://browser/content/sval/ext-bookmarks.js
# A window's page actions show in the extensions menu; see sval-page-actions.js.
% override chrome://browser/content/browser-pageActions.js chrome://browser/content/sval/sval-page-actions.js
# about:privatebrowsing is Sval's home page in the private palette. The about:
# module maps it to this chrome URL (`kRedirMap`, `AboutRedirector.cpp`), so
# overriding the URL replaces the page without a patch. about:home and
# about:newtab reach home.html through `AboutNewTabRedirector`'s `defaultURL`.
% override chrome://browser/content/aboutPrivateBrowsing.html chrome://browser/content/sval/home/private.html
