# Everything Sval loads by URL at runtime: the chrome window's panel code, the
# worker, and the engine the worker imports. `.sys.mjs` modules are not here —
# they go through MOZ_SRC_FILES in moz.build and are imported as moz-src URLs.
browser.jar:
# Kit, Firefox's fox mascot, illustrates Firefox's own promos (settings' default
# browser card, the PDF default prompt). It is Mozilla's artwork, which Sval may
# not ship, so Sval's logo stands in.
% override chrome://global/skin/illustrations/kit-concerned.svg chrome://branding/content/about-logo.svg
% override chrome://global/skin/illustrations/kit-happy.svg chrome://branding/content/about-logo.svg
# Firefox's logo glyphs: settings' About and Languages icons and the Sval View
# button take Sval's glyph.
% override chrome://browser/skin/sidebar/firefox.svg chrome://browser/content/sval/sval-glyph.svg
# BEGIN Firefox icons: generated by scripts/check-icons.py --write from
