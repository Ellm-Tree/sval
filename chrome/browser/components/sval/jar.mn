# A new profile starts with no bookmarks; see default-bookmarks.html.
% override chrome://browser/content/default-bookmarks.html chrome://browser/content/sval/default-bookmarks.html
# Extensions' bookmarks are Favorites: the bookmarks API over the engine's
# document (favorites-native spec §8), with Firefox's schema and permission.
% override chrome://browser/content/parent/ext-bookmarks.js chrome://browser/content/sval/ext-bookmarks.js
# A window's page actions show in the extensions menu; see sval-page-actions.js.
% override chrome://browser/content/browser-pageActions.js chrome://browser/content/sval/sval-page-actions.js
# about:privatebrowsing is Sval's home page in the private palette. The about:
# module maps it to this chrome URL (`kRedirMap`, `AboutRedirector.cpp`), so
# overriding the URL replaces the page without a patch. about:home and
# about:newtab reach home.html through `AboutNewTabRedirector`'s `defaultURL`.
% override chrome://browser/content/aboutPrivateBrowsing.html chrome://browser/content/sval/home/private.html
