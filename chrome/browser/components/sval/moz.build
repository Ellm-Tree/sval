EXTRA_COMPONENTS += [
    "sval.manifest",
]

# Where Gecko asks Sval about a page's file pickers, downloads and clipboard
# writes in an agent's tab (SvalAgentFiles.h), and Places a visit's workspace.
XPIDL_SOURCES += ["nsISvalAgentFiles.idl", "nsISvalVisitWorkspaces.idl"]
XPIDL_MODULE = "browser_sval"
EXPORTS.mozilla += ["SvalAgentFiles.h"]
XPCOM_MANIFESTS += ["components.conf"]

JAR_MANIFESTS += ["jar.mn"]

# Sval's own Fluent strings.
DIRS += ["locales"]

BROWSER_CHROME_MANIFESTS += [
    "test/browser/browser-agent-screenshot-video.toml",
    "test/browser/browser-first-run-closed.toml",
    "test/browser/browser-first-run-default-answer.toml",
    "test/browser/browser-first-run-default-browser.toml",
    "test/browser/browser-first-run-emptied.toml",
    "test/browser/browser-first-run-escape.toml",
    "test/browser/browser-first-run-existing.toml",
    "test/browser/browser-first-run-import.toml",
    "test/browser/browser-first-run-join-backup.toml",
    "test/browser/browser-first-run-join-cancel.toml",
    "test/browser/browser-first-run-join-code.toml",
    "test/browser/browser-first-run-join-lands.toml",
    "test/browser/browser-first-run-join-later.toml",
    "test/browser/browser-first-run-join-waiting.toml",
    "test/browser/browser-first-run-kagi-later.toml",
    "test/browser/browser-first-run-kagi.toml",
    "test/browser/browser-first-run-later.toml",
    "test/browser/browser-first-run-new-path.toml",
    "test/browser/browser-first-run-replaced.toml",
    "test/browser/browser-first-run-second-window.toml",
    "test/browser/browser-first-run-shared-new.toml",
    "test/browser/browser-first-run-tour.toml",
    "test/browser/browser-pairing-code.toml",
    "test/browser/browser-pairing-join-first.toml",
    "test/browser/browser-pairing-join.toml",
    "test/browser/browser-pairing-offer.toml",
    "test/browser/browser-private-only.toml",
    "test/browser/browser-sync-key.toml",
    "test/browser/browser-webgpu.toml",
    "test/browser/browser.toml",
]

XPCSHELL_TESTS_MANIFESTS += ["test/xpcshell/xpcshell.toml"]

# The real-share suite. Every task skips unless the nightly job sets
# SVAL_CI_SHARES=1.
XPCSHELL_TESTS_MANIFESTS += ["test/shares/xpcshell/xpcshell.toml"]
BROWSER_CHROME_MANIFESTS += ["test/shares/browser/browser.toml"]
TESTING_JS_MODULES += ["test/shares/SvalSharesTestUtils.sys.mjs"]

# The suite against the platform's own key store. Every task skips unless the
# daily CI run sets SVAL_CI_OS_KEYSTORE=1.
XPCSHELL_TESTS_MANIFESTS += ["test/os-keystore/xpcshell.toml"]

# Temporary files and directories every Sval suite makes, each removed with its
# test file.
TESTING_JS_MODULES += ["test/SvalTestTemp.sys.mjs"]

# A clock a test moves by hand, in both suites.
TESTING_JS_MODULES += ["test/SvalTestClock.sys.mjs"]

# The bound every Sval suite puts on a wait for an event.
TESTING_JS_MODULES += ["test/SvalTestWait.sys.mjs"]

# A refused read or write, provoked on every platform.
TESTING_JS_MODULES += ["test/SvalTestDeny.sys.mjs"]

# A failed engine call, which fails its test when it never happened.
TESTING_JS_MODULES += ["test/SvalTestFault.sys.mjs"]

# The loopback agent client the listener's tests connect with, in both suites.
TESTING_JS_MODULES += ["test/SvalTestAgentClient.sys.mjs"]

# The state every browser-chrome file starts from, kept for the whole run.
TESTING_JS_MODULES += ["test/SvalTestSlate.sys.mjs"]

# What the browser-chrome harness removes before every file, Mozilla's
# included: the workspaces earlier files left.
TESTING_JS_MODULES += ["test/SvalTestLeftovers.sys.mjs"]
