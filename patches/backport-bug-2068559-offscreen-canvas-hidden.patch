+void HTMLCanvasElement::NotifyOwnerDocumentActivityChanged() {
+  if (!mOffscreenDisplay) {
+    return;
+  }
+
+  BrowsingContext* bc = OwnerDoc()->GetBrowsingContext();
+  mOffscreenDisplay->SetPresentationEnabled(bc && bc->IsActive());
+}
