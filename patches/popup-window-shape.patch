+void XULPopupElement::SetWindowShape(const PopupWindowShape& aShape) {
+  nsIWidget::WindowShape shape;
+  for (const auto& ring : aShape.mRings) {
+    if (ring.Length() < 6) {
+      continue;
+    }
+    auto points = shape.mRings.AppendElement();
+    for (size_t i = 0; i + 1 < ring.Length(); i += 2) {
+      points->AppendElement(
+          LayoutDevicePoint(float(ring[i]), float(ring[i + 1])));
+    }
+  }
+  for (const auto& part : aShape.mParts) {
+    shape.mParts.AppendElement(nsIWidget::WindowShape::Part{
+        LayoutDeviceRect(float(part.mX), float(part.mY), float(part.mWidth),
+                         float(part.mHeight)),
+        LayoutDeviceCoord(float(part.mRadius))});
+  }
+  mWindowShape = std::move(shape);
+  if (nsMenuPopupFrame* f = do_QueryFrame(GetPrimaryFrame())) {
+    f->PropagateWindowShape();
+  }
+}
+
+bool XULPopupElement::HasWindowShape() {
+  nsMenuPopupFrame* f = do_QueryFrame(GetPrimaryFrame());
+  nsIWidget* widget = f ? f->GetWidget() : nullptr;
+  return widget && widget->HasWindowShape();
+}
