+
+void nsMenuPopupFrame::PropagateWindowShape() const {
+  nsIWidget* widget = GetWidget();
+  if (!widget) {
+    return;
+  }
+  const nsIWidget::WindowShape& css = PopupElement().GetWindowShape();
+  const float scale = PresContext()->CSSToDevPixelScale().scale;
+  nsIWidget::WindowShape shape;
+  for (const auto& ring : css.mRings) {
+    auto points = shape.mRings.AppendElement();
+    for (const auto& point : ring) {
+      points->AppendElement(
+          LayoutDevicePoint(point.x * scale, point.y * scale));
+    }
+  }
+  for (const auto& part : css.mParts) {
+    const auto& r = part.mRect;
+    shape.mParts.AppendElement(nsIWidget::WindowShape::Part{
+        LayoutDeviceRect(r.x * scale, r.y * scale, r.width * scale,
+                         r.height * scale),
+        LayoutDeviceCoord(part.mRadius * scale)});
+  }
+  widget->SetWindowShape(shape);
 }
 
