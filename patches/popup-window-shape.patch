+void nsCocoaWindow::SetWindowShape(const WindowShape& aShape) {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+
+  mWindowShape.mRings.Clear();
+  for (const auto& ring : aShape.mRings) {
+    mWindowShape.mRings.AppendElement(ring.Clone());
+  }
+  mWindowShape.mParts = aShape.mParts.Clone();
+
+  if (!mWindow || mWindowType != WindowType::Popup) {
+    return;
+  }
+
+  mWindow.windowShape = &mWindowShape;
+  [mWindow setEffectViewWrapperForStyle:mShadowStyle];
+  [mWindow invalidateShadow];
+
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
+
+bool nsCocoaWindow::HasWindowShape() const {
+  return mWindow && mWindowType == WindowType::Popup &&
+         mShadowStyle == WindowShadow::Menu && !mWindowShape.IsEmpty();
+}
