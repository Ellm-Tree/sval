+// A popup's window, and with it the backdrop DWM draws behind it, is cut to
+// the shape's rings: the region a window shows (SetWindowRgn), in the
+// window's own pixels, which the system owns once it is set.
+void nsWindow::SetWindowShape(const WindowShape& aShape) {
+  if (!mWnd || !IsPopup()) {
+    return;
+  }
+  if (aShape.IsEmpty()) {
+    ::SetWindowRgn(mWnd, nullptr, TRUE);
+    mHasWindowShape = false;
+    return;
+  }
+  nsTArray<POINT> points;
+  nsTArray<INT> counts;
+  for (const auto& ring : aShape.mRings) {
+    for (const auto& point : ring) {
+      points.AppendElement(POINT{LONG(floorf(point.x.value + 0.5f)),
+                                 LONG(floorf(point.y.value + 0.5f))});
+    }
+    counts.AppendElement(INT(ring.Length()));
+  }
+  HRGN region = ::CreatePolyPolygonRgn(points.Elements(), counts.Elements(),
+                                       INT(counts.Length()), ALTERNATE);
+  mHasWindowShape = region && ::SetWindowRgn(mWnd, region, TRUE);
+  if (region && !mHasWindowShape) {
+    ::DeleteObject(region);
+  }
+}
