-  if (aPrincipal->GetIsInPrivateBrowsing() &&
-      !StaticPrefs::dom_webnotifications_privateBrowsing_enabled()) {
-    return true;
-  }
+static bool IsOffInPrivateBrowsing(nsIPrincipal* aPrincipal) {
