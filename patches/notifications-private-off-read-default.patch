       glean::web_notification::insecure_context_permission_request.Add();
@@ -123,6 +123,16 @@ bool IsNotificationForbiddenFor(nsIPrincipal* aPrincipal,
   return !StaticPrefs::dom_webnotifications_allowcrossoriginiframe();
