+// Sval: page rules. They come from the engines
+// that block in the window's kind, so one set of lists serves requests and
+// pages.
+
+NS_IMETHODIMP ContentClassifierService::PageRules(
+    const nsACString& aUrl, bool aPrivateBrowsing,
+    nsIContentClassifierPageRules** aRules) {
+  // adblock-rust's answer depends on the whole URL: its host's rules, and
+  // whether a $generichide or $elemhide exception matches the URL
+  // (Engine::url_cosmetic_resources). The engines are asked without the
+  // fragment, so an address's in-page links share one answer.
+  nsCOMPtr<nsIURI> uri;
+  nsAutoCString spec;
+  if (NS_FAILED(NS_NewURI(getter_AddRefs(uri), aUrl)) ||
+      NS_FAILED(uri->GetSpecIgnoringRef(spec))) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  nsAutoCString key(spec);
+  key.Append(aPrivateBrowsing ? " p" : " n");
+  MutexAutoLock lock(mLock);
+  if (auto cached = mCosmeticCache.Lookup(key)) {
+    NS_ADDREF(*aRules = cached.Data());
+    return NS_OK;
+  }
+  RefPtr<SvalClassifierPageRules> rules = new SvalClassifierPageRules();
+  for (const auto& engine :
+       aPrivateBrowsing ? mCancelEnginesPBM : mCancelEngines) {
+    rules->Add(*engine, spec);
+  }
+  constexpr uint32_t kMaxCachedUrls = 256;
+  if (mCosmeticCache.Count() >= kMaxCachedUrls) {
+    mCosmeticCache.Clear();
+  }
+  mCosmeticCache.InsertOrUpdate(key, RefPtr{rules});
+  rules.forget(aRules);
+  return NS_OK;
+}
+
+NS_IMETHODIMP ContentClassifierService::HiddenClassIdSelectors(
+    const nsTArray<nsCString>& aClasses, const nsTArray<nsCString>& aIds,
+    const nsTArray<nsCString>& aExceptions, bool aPrivateBrowsing,
+    nsTArray<nsCString>& aSelectors) {
+  aSelectors.Clear();
+  MutexAutoLock lock(mLock);
+  for (const auto& engine :
+       aPrivateBrowsing ? mCancelEnginesPBM : mCancelEngines) {
+    (void)SvalClassifierEngine::HiddenClassIdSelectors(
+        *engine, aClasses, aIds, aExceptions, aSelectors);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP ContentClassifierService::SetScriptletResources(
+    const nsACString& aResourcesJson) {
+  // Parsed once, outside the lock; a library that does not parse leaves the
+  // one in use.
+  RefPtr<SvalClassifierResources> resources =
+      SvalClassifierResources::FromJson(aResourcesJson);
+  if (!resources) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  MutexAutoLock lock(mLock);
+  mScriptletResources = resources;
+  mCosmeticCache.Clear();
+  for (const auto& entry : mEngines) {
+    (void)SvalClassifierEngine::UseResources(*entry.GetData(), *resources);
+  }
+  return NS_OK;
+}
