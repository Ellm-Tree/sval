Sval: a tab's compositor animations are cleared when its layer tree goes

Backport of Mozilla's Bug 2093687 (mozilla-central 64becaa04e20, Firefox
162), unchanged but for context. ESR 153 does not carry it.
EraseLayerState erased a layer tree's state and then destroyed its
WebRenderBridgeParent. The bridge finds its root compositor's OMTASampler
through that state, so it found none and left its compositor animations in
CompositorAnimationStorage. The window's compositor then sampled them and
composited on every vsync for the rest of the GPU process's life, with the
tab long gone. The bridge is destroyed while the state still exists.

diff --git a/gfx/layers/ipc/CompositorBridgeParent.cpp b/gfx/layers/ipc/CompositorBridgeParent.cpp
--- a/gfx/layers/ipc/CompositorBridgeParent.cpp
+++ b/gfx/layers/ipc/CompositorBridgeParent.cpp
@@ -1449,11 +1449,26 @@
         auto* state =
             CompositorBridgeParent::GetLayerTreeStateUnderLock(aId, aProof);
         if (state) {
+          wrBridge = state->mWrBridge;
+        }
+      });
+
+  // Destroy the bridge before erasing its layer tree state: it finds its root
+  // compositor's OMTASampler through that state, and needs it to remove its
+  // compositor animations, which would otherwise be sampled forever.
+  if (wrBridge) {
+    wrBridge->Destroy();
+  }
+
+  CompositorBridgeParent::WithIndirectLayerTreesLock(
+      [&](const StaticMonitorAutoLock& aProof) {
+        auto* state =
+            CompositorBridgeParent::GetLayerTreeStateUnderLock(aId, aProof);
+        if (state) {
           CompositorBridgeParent* parent = state->mParent;
           if (parent) {
             apz = parent->GetAPZUpdater();
           }
-          wrBridge = state->mWrBridge;
           CompositorBridgeParent::EraseLayerTreeStateUnderLock(aId, aProof);
         }
       });
@@ -1461,10 +1476,6 @@
   if (apz) {
     apz->NotifyLayerTreeRemoved(aId);
   }
-
-  if (wrBridge) {
-    wrBridge->Destroy();
-  }
 }

 /*static*/
