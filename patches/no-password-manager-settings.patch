Sval: hide password and card settings that ignore the manager being off

Sval turns Firefox's password manager and card autofill off (Sval spec §7.3).
The settings for OS reauthentication, site exceptions and the Primary
Password show regardless, and they have no pref of their own to lock, so
their visibility follows the feature they belong to.

diff --git a/browser/components/preferences/config/passwords-autofill.mjs b/browser/components/preferences/config/passwords-autofill.mjs
index d2b3d20659..c2d2270a00 100644
--- a/browser/components/preferences/config/passwords-autofill.mjs
+++ b/browser/components/preferences/config/passwords-autofill.mjs
@@ -303,7 +303,9 @@ Preferences.addSetting({
 });
 Preferences.addSetting({
   id: "requireOSAuthForPayments",
-  visible: () => lazy.OSKeyStore.canReauth(),
+  // Sval: only with card autofill (Sval spec §7.3).
+  visible: () =>
+    FormAutofill.isAutofillCreditCardsAvailable && lazy.OSKeyStore.canReauth(),
   get: () => FormAutofillUtils.getOSAuthEnabled(),
   async set(checked) {
     await lazy.FormAutofillPreferences.trySetOSAuthEnabled(window, checked);
@@ -537,6 +539,8 @@ Preferences.addSetting({
 
 Preferences.addSetting({
   id: "managePasswordExceptions",
+  // Sval: only with the password manager (Sval spec §7.3).
+  visible: () => lazy.LoginHelper.enabled,
   disabled: () =>
     Services.prefs.prefIsLocked(
       "pref.privacy.disable_button.view_passwords_exceptions"
@@ -559,7 +563,8 @@ Preferences.addSetting({
 
 Preferences.addSetting({
   id: "requireOSAuthForPasswords",
-  visible: () => lazy.OSKeyStore.canReauth(),
+  // Sval: only with the password manager (Sval spec §7.3).
+  visible: () => lazy.LoginHelper.enabled && lazy.OSKeyStore.canReauth(),
   get: () => lazy.LoginHelper.getOSAuthEnabled(),
   async set(checked) {
     const [messageText, captionText] = await Promise.all([
@@ -615,8 +620,9 @@ Preferences.addSetting({
     Services.obs.addObserver(emitChange, topic);
     return () => Services.obs.removeObserver(emitChange, topic);
   },
+  // Sval: only with the password manager (Sval spec §7.3).
   visible: () => {
-    return !lazy.LoginHelper.isPrimaryPasswordSet();
+    return lazy.LoginHelper.enabled && !lazy.LoginHelper.isPrimaryPasswordSet();
   },
 });
 
@@ -643,8 +649,9 @@ Preferences.addSetting({
     Services.obs.addObserver(emitChange, topic);
     return () => Services.obs.removeObserver(emitChange, topic);
   },
+  // Sval: only with the password manager (Sval spec §7.3).
   visible: () => {
-    return lazy.LoginHelper.isPrimaryPasswordSet();
+    return lazy.LoginHelper.enabled && lazy.LoginHelper.isPrimaryPasswordSet();
   },
 });
 
