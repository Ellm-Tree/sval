               <html:span id="translations-button-locale" aria-hidden="true" />
             </hbox>
-            <toolbarbutton id="urlbar-zoom-button"
-                    tooltip="dynamic-shortcut-tooltip"
-                    hidden="true"/>
             <hbox id="pageActionButton"
                   class="urlbar-page-action"
                   role="button"
