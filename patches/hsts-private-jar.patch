+
+// static
+void nsSiteSecurityService::RemoveEntriesMatching(
+    nsIDataStorage* aStorage, const char16_t* aPatternJSON) {
+  OriginAttributesPattern pattern;
+  if (!pattern.Init(nsDependentString(aPatternJSON))) {
+    return;
+  }
+  nsTArray<RefPtr<nsIDataStorageItem>> items;
+  if (NS_FAILED(aStorage->GetAll(items))) {
+    return;
+  }
+  for (const auto& item : items) {
+    nsIDataStorage::DataType type;
+    nsAutoCString key;
+    if (NS_FAILED(item->GetType(&type)) || NS_FAILED(item->GetKey(key))) {
+      continue;
+    }
+    nsAutoCString hostname;
+    OriginAttributes attrs;
+    if (attrs.PopulateFromOrigin(key, hostname) && pattern.Matches(attrs)) {
+      (void)aStorage->Remove(key, type);
+    }
+  }
+}
