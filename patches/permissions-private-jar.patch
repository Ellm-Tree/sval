Sval: a private session's permissions are its own

Each private window is a browsing session of its own, told apart by its
userContextId. The permission manager drops userContextId from every
permission key unless permissions.isolateBy.userContext is set, so a grant
made in one private window (a site's camera, a storage-access grant, a
tracking-protection exception) would hold in every other. A private
principal keeps it; normal windows keep the one key per site that the pref
gives them, which their isolated workspaces rely on. The pref cannot be
flipped instead, because that splits normal-window permissions too. The
subdomain principal the manager looks up follows the same rule. The
built-in defaults are imported for private browsing once, with no
userContextId, so a private session with no entry of its own for a type
reads the default. Bounce tracking protection's allow-list cache keys a
private entry by its userContextId too, as the permission it comes from.

diff --git a/caps/BasePrincipal.cpp b/caps/BasePrincipal.cpp
index 107f504c2b..3841fb8b6c 100644
--- a/caps/BasePrincipal.cpp
+++ b/caps/BasePrincipal.cpp
@@ -1494,7 +1494,10 @@ BasePrincipal::GetNextSubDomainPrincipal(
   // Copy the attributes over
   mozilla::OriginAttributes attrs = OriginAttributesRef();
 
-  if (!StaticPrefs::permissions_isolateBy_userContext()) {
+  // Sval: as PermissionManager::MaybeStripOriginAttributes, a private
+  // principal keeps its userContextId.
+  if (!StaticPrefs::permissions_isolateBy_userContext() &&
+      !attrs.IsPrivateBrowsing()) {
     // Disable userContext for permissions.
     attrs.StripAttributes(mozilla::OriginAttributes::STRIP_USER_CONTEXT_ID);
   }
diff --git a/extensions/permissions/PermissionManager.cpp b/extensions/permissions/PermissionManager.cpp
index 8195065ac1..28b6d8ea89 100644
--- a/extensions/permissions/PermissionManager.cpp
+++ b/extensions/permissions/PermissionManager.cpp
@@ -2804,6 +2804,31 @@ nsresult PermissionManager::CommonTestPermissionInternal(
       aPrincipal ? GetPermissionHashKey(aPrincipal, aTypeIndex, aExactHostMatch)
                  : GetPermissionHashKey(aURI, aOriginAttributes, aTypeIndex,
                                         aExactHostMatch);
+  // Sval: the built-in defaults are imported for private browsing once, with
+  // no userContextId, and each private session is one. A session that has
+  // no entry of its own for the type reads the default.
+  if (!entry && aPrincipal && aPrincipal->GetIsInPrivateBrowsing() &&
+      aPrincipal->OriginAttributesRef().mUserContextId &&
+      !IsOAForceStripPermission(aType)) {
+    nsresult rv;
+    RefPtr<PermissionKey> ownKey = PermissionKey::CreateFromPrincipal(
+        aPrincipal, false, IsSiteScopedPermission(aType), rv);
+    PermissionHashKey* own =
+        ownKey ? mPermissionTable.GetEntry(ownKey) : nullptr;
+    if (!own || own->GetPermissionIndex(aTypeIndex) < 0) {
+      OriginAttributes attrs = aPrincipal->OriginAttributesRef();
+      attrs.mUserContextId = nsIScriptSecurityManager::DEFAULT_USER_CONTEXT_ID;
+      nsCOMPtr<nsIPrincipal> shared =
+          BasePrincipal::Cast(aPrincipal)->CloneForcingOriginAttributes(attrs);
+      PermissionHashKey* fallback =
+          shared ? GetPermissionHashKey(shared, aTypeIndex, aExactHostMatch)
+                 : nullptr;
+      if (fallback &&
+          fallback->GetPermission(aTypeIndex).mID == cIDPermissionIsDefault) {
+        entry = fallback;
+      }
+    }
+  }
   if (!entry || (!aIncludingSession &&
                  entry->GetPermission(aTypeIndex).mNonSessionExpireType ==
                      nsIPermissionManager::EXPIRE_SESSION)) {
@@ -4453,7 +4478,14 @@ void PermissionManager::MaybeStripOriginAttributes(
     flags |= OriginAttributes::STRIP_PRIVATE_BROWSING_ID;
   }
 
-  if (aForceStrip || !StaticPrefs::permissions_isolateBy_userContext()) {
+  // Sval: a private principal keeps its userContextId, because in private
+  // browsing each userContextId is a session of its own, and a permission
+  // one session was granted must not be readable in another.
+  bool keepsPrivateSession =
+      !(flags & OriginAttributes::STRIP_PRIVATE_BROWSING_ID) &&
+      aOriginAttributes.IsPrivateBrowsing();
+  if (aForceStrip || (!StaticPrefs::permissions_isolateBy_userContext() &&
+                      !keepsPrivateSession)) {
     flags |= OriginAttributes::STRIP_USER_CONTEXT_ID;
   }
 
