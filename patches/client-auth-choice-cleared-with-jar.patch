+    let cars = Cc[
+      "@mozilla.org/security/clientAuthRememberService;1"
+    ].getService(Ci.nsIClientAuthRememberService);
+    let pattern = JSON.parse(aOriginAttributesString);
+
+    cars
+      .getDecisions()
+      .filter(({ entryKey }) => {
+        try {
+          return ChromeUtils.originAttributesMatchPattern(
+            ChromeUtils.CreateOriginAttributesFromOriginSuffix(
+              decodeURIComponent(entryKey.split(",")[2])
+            ),
+            pattern
+          );
+        } catch (e) {
+          console.error(e);
+          return false;
+        }
+      })
+      .forEach(({ entryKey }) => cars.forgetRememberedDecision(entryKey));
+  },
+
