@@ -15,6 +17,7 @@
 #include "mozilla/dom/ScriptSettings.h"
 #include "nsPIDOMWindow.h"
 #include "nsPIDOMWindowInlines.h"
+#include "xpcpublic.h"
 
 namespace mozilla::dom {
 
@@ -49,6 +52,19 @@ ModelContext::ModelContext(nsPIDOMWindowInner* aWindow) : mWindow(aWindow) {
   MOZ_ASSERT(aWindow);
 }
 
+/* static */
+bool ModelContext::IsExposed(JSContext* aCx, JSObject* aGlobal) {
+  if (!StaticPrefs::dom_modelcontext_enabled()) {
+    return false;
+  }
+  nsPIDOMWindowInner* win = xpc::WindowOrNull(aGlobal);
+  if (!win) {
+    return false;
+  }
+  BrowsingContext* bc = win->GetBrowsingContext();
+  return bc && bc->Top()->GetSvalAgentTab();
+}
+
 JSObject* ModelContext::WrapObject(JSContext* aCx,
