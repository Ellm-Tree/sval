     return IsWindowAllowedToPlayBySitePermission(
-        aElement.OwnerDoc()->GetInnerWindow());
+               aElement.OwnerDoc()->GetInnerWindow()) ||
+           IsAllowedToPlayByPress(aElement);
   }
 
   bool isInaudible = IsMediaElementInaudible(aElement);
@@ -409,6 +435,15 @@ DocumentAutoplayPolicy IsDocAllowedToPlay(const Document& aDocument) {
   return DocumentAutoplayPolicy::Disallowed;
 }
 
+/* static */
+bool AutoplayPolicy::IsAllowedToPlayOnlyByPress(
+    const HTMLMediaElement& aElement) {
+  return StaticPrefs::media_autoplay_site_permission_only() &&
+         !IsWindowAllowedToPlayBySitePermission(
+             aElement.OwnerDoc()->GetInnerWindow()) &&
+         IsAllowedToPlayByPress(aElement);
+}
