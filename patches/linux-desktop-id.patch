diff --git a/widget/gtk/MPRISServiceHandler.cpp b/widget/gtk/MPRISServiceHandler.cpp
index ca18fa5..9a19ffa 100644
--- a/widget/gtk/MPRISServiceHandler.cpp
+++ b/widget/gtk/MPRISServiceHandler.cpp
@@ -484,15 +484,18 @@ void MPRISServiceHandler::InitIdentity() {
   rv = appInfo->GetVendor(mIdentity);
   MOZ_ASSERT(NS_SUCCEEDED(rv));
 
+  nsAutoCString name;
   if (gAppData) {
-    mDesktopEntry = gAppData->remotingName;
+    name = gAppData->remotingName;
+    mDesktopEntry = GetDesktopEntryId();
   } else {
-    rv = appInfo->GetName(mDesktopEntry);
+    rv = appInfo->GetName(name);
