+    mDesktopEntry = name;
   }
 
   mIdentity.Append(' ');
-  mIdentity.Append(mDesktopEntry);
+  mIdentity.Append(name);
 
   LOGMPRIS("InitIdentity() MPRIS desktop ID %s", mDesktopEntry.get());
 }
