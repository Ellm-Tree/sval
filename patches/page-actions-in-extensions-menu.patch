Sval: show page actions in the extensions menu

Sval's jar.mn overrides browser-pageActions.js with sval-page-actions.js,
which draws an extension's page action on its row of the extensions menu
and marks the extensions button while one shows for the selected tab.
The address field's page action menu button, the panel it opened and the
context menu of its buttons go, with the bookmark panel item's label
update and their rules and strings. The extensions menu lists each row's
page action wherever it lists the row's site switch.

diff --git a/browser/base/content/browser-addons.js b/browser/base/content/browser-addons.js
index c6096268bf..5ca49b0fa8 100644
--- a/browser/base/content/browser-addons.js
+++ b/browser/base/content/browser-addons.js
@@ -2446,6 +2446,7 @@ var gUnifiedExtensions = {
     // the selected tab's site.
     lazy.SvalExtensionsMenu.listPinned(window, list);
     lazy.SvalExtensionsMenu.addSwitches(window, panelview);
+    lazy.SvalExtensionsMenu.addPageActions(window, panelview);
 
     const emptyStateBox = panelview.querySelector(
       "#unified-extensions-empty-state"
@@ -2980,6 +2981,7 @@ var gUnifiedExtensions = {
     if (list && this._panel?.state === "open") {
       lazy.SvalExtensionsMenu.listPinned(window, list);
       lazy.SvalExtensionsMenu.addSwitches(window, this._panel);
+      lazy.SvalExtensionsMenu.addPageActions(window, this._panel);
