       this.tabbrowser.splitViewBrowsers.includes(browser) ||
-      lazy.PictureInPicture.isOriginatingBrowser(browser)
+      lazy.PictureInPicture.isOriginatingBrowser(browser) ||
+      // Sval: a page shown over the selected one (`Tabbrowser.showsOverTab`).
+      this.tabbrowser.showsOverTab(browser)
     );
   }
 
