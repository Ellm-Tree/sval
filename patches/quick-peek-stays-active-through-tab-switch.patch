+    /**
+     * Sval: whether `aBrowser`'s page shows over the selected tab, as a
+     * Quick Peek's does (SvalQuickPeekTab marks its tab). Its own code keeps it active
+     * while it shows, as `showSplitViewPanels` keeps a split's panes, so the
+     * tab switcher leaves it alone.
+     *
+     * @param {MozBrowser} aBrowser
+     * @returns {boolean}
+     */
+    showsOverTab(aBrowser) {
+      return !!this.getTabForBrowser(aBrowser)?.hasAttribute("sval-quick-peek");
+    }
