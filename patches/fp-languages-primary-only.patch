+void WorkerNavigator::GetLanguages(nsTArray<nsString>& aLanguages) const {
+  aLanguages = mProperties.mLanguages.Clone();
+  WorkerPrivate* workerPrivate = GetCurrentThreadWorkerPrivate();
+  if (workerPrivate && workerPrivate->GetLanguageOverride().IsEmpty() &&
+      workerPrivate->ShouldResistFingerprinting(
+          RFPTarget::LanguagesPrimaryOnly)) {
+    SvalRFPService::SpoofLanguages(aLanguages);
+  }
+}
