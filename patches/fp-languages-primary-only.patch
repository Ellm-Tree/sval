diff --git a/netwerk/protocol/http/nsHttpHandler.cpp b/netwerk/protocol/http/nsHttpHandler.cpp
index d7c4ee4d66..d82223d208 100644
--- a/netwerk/protocol/http/nsHttpHandler.cpp
+++ b/netwerk/protocol/http/nsHttpHandler.cpp
@@ -2122,9 +2122,29 @@ nsresult nsHttpHandler::SetAcceptLanguages() {
   if (NS_SUCCEEDED(rv)) {
     mAcceptLanguages.Assign(buf);
   }
+
+  nsTArray<nsCString> languages;
+  for (const auto& language :
+       nsCCharSeparatedTokenizer(acceptLanguages, ',').ToRange()) {
+    languages.AppendElement(language);
+  }
+  SvalRFPService::SpoofLanguages(languages);
+  nsAutoCString primaryOnly;
+  StringJoinAppend(primaryOnly, ","_ns, languages);
+  buf.Truncate();
+  if (NS_SUCCEEDED(PrepareAcceptLanguages(primaryOnly.get(), buf))) {
+    mAcceptLanguagesPrimaryOnly.Assign(buf);
+  }
   return rv;
 }
 
+const nsCString& nsHttpHandler::AcceptLanguages(bool aPrimaryOnly) {
+  if (mAcceptLanguagesIsDirty) {
+    (void)SetAcceptLanguages();
+  }
+  return aPrimaryOnly ? mAcceptLanguagesPrimaryOnly : mAcceptLanguages;
+}
