+  // Accept-Language takes the decision the loaded document makes for
+  // navigator.languages, Document::ShouldResistFingerprinting's: the channel
+  // check together with the granular overrides the anti-tracking info just
+  // put on the load. A header still in either of nsHttpHandler's forms is set
+  // to this load's, so a redirect, which copies the header, carries the final
+  // site's. A header someone set is kept.
+  nsAutoCString acceptLanguage;
+  if (NS_SUCCEEDED(
+          mRequestHead.GetHeader(nsHttp::Accept_Language, acceptLanguage)) &&
+      (acceptLanguage.Equals(gHttpHandler->AcceptLanguages(false)) ||
+       acceptLanguage.Equals(gHttpHandler->AcceptLanguages(true)))) {
+    bool primaryOnly =
+        nsContentUtils::ShouldResistFingerprinting(
+            this, RFPTarget::IsAlwaysEnabledForPrecompute) &&
+        nsRFPService::IsRFPEnabledFor(
+            NS_UsePrivateBrowsing(this), RFPTarget::LanguagesPrimaryOnly,
+            mLoadInfo->GetOverriddenFingerprintingSettings());
+    rv = mRequestHead.SetHeader(nsHttp::Accept_Language,
+                                gHttpHandler->AcceptLanguages(primaryOnly),
+                                false,
+                                nsHttpHeaderArray::eVarietyRequestOverride);
+    MOZ_ASSERT(NS_SUCCEEDED(rv));
+  }
+
   if (WaitingForTailUnblock()) {
