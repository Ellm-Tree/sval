   NSWindow* window = NativeWindowForFrame(aFrame);
   if (!window) {
     // Return fallback values.
-    return NSSize{54, 16};
+    return WindowButtonsBoxSize(aFrame, NSSize{54, 16});
   }
 
   NSRect buttonBox = NSZeroRect;
