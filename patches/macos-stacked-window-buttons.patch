+// A box laid out in a vertical writing mode holds the buttons stacked, close
+// over minimize over zoom (StackedWindowButtonOrigin in nsCocoaWindow.mm), so
+// it takes their row's size turned on its side.
+static NSSize WindowButtonsBoxSize(nsIFrame* aFrame, NSSize aButtons) {
+  const bool stacked = aFrame->GetWritingMode().IsVertical();
+  if (stacked != (aButtons.height > aButtons.width)) {
+    return NSSize{aButtons.height, aButtons.width};
+  }
+  return aButtons;
+}
+
