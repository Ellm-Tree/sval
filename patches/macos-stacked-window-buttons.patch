+// The window buttons stand stacked, close over minimize over zoom, when the
+// chrome lays their box out taller than it is wide, as a vertical writing
+// mode does (WindowButtonsSize in nsNativeThemeCocoa.mm). Each button's
+// origin is in non-flipped window coordinates, the box's spare height shared
+// between the gaps.
+static bool StackedWindowButtonOrigin(NSWindow* aWindow, int aIndex,
+                                      NSPoint* aOrigin) {
+  if (![aWindow isKindOfClass:[ToolbarWindow class]]) {
+    return false;
+  }
+  auto* win = static_cast<ToolbarWindow*>(aWindow);
+  if (!win.drawsContentsIntoWindowFrame ||
+      (win.styleMask & NSWindowStyleMaskFullScreen) ||
+      !(win.styleMask & NSWindowStyleMaskTitled)) {
+    return false;
+  }
+  const NSRect buttonsRect = win.windowButtonsRect;
+  if (NSIsEmptyRect(buttonsRect) ||
+      buttonsRect.size.height <= buttonsRect.size.width) {
+    return false;
+  }
+  const CGFloat button =
+      [win standardWindowButton:NSWindowCloseButton].frame.size.height;
+  const CGFloat step = (buttonsRect.size.height - button) / 2;
+  *aOrigin = NSMakePoint(buttonsRect.origin.x, buttonsRect.origin.y +
+                                                   buttonsRect.size.height -
+                                                   button - aIndex * step);
+  return true;
+}
