Sval: read Apple's password helper manifest from the system Mozilla folder

Sval reads native messaging manifests from its own folders, apart from the
Mozilla folders every Firefox-family app shares. macOS itself installs
com.apple.passwordmanager.json, the manifest the iCloud Passwords
extension asks for, in /Library/Application Support/Mozilla alone among the
folders a Gecko browser reads, as a link into the system volume. Apple
writes no copy to a folder of Sval's, so without this the extension never
finds its helper in Sval. On macOS a lookup for that one name also tries
that folder, after Sval's own.

diff --git a/toolkit/components/extensions/NativeManifests.sys.mjs b/toolkit/components/extensions/NativeManifests.sys.mjs
index a6648403a7..9716303a75 100644
--- a/toolkit/components/extensions/NativeManifests.sys.mjs
+++ b/toolkit/components/extensions/NativeManifests.sys.mjs
@@ -26,6 +26,12 @@ const NATIVE_MANIFEST_SCHEMA =
 // Firefox-family app reads.
 const REGPATH = `Software\\${AppConstants.MOZ_APP_BASENAME}`;
 
+// Sval: macOS installs the manifest for Apple's password helper in this
+// folder and in Chrome's, and nowhere an application chooses. This name alone
+// is read from there.
+const APPLE_PASSWORDS_HOST = "com.apple.passwordmanager";
+const APPLE_PASSWORDS_DIR = "/Library/Application Support/Mozilla";
+
 export var NativeManifests = {
   _initializePromise: null,
   _lookup: null,
@@ -41,7 +47,16 @@ export var NativeManifests = {
           Services.dirsvc.get("XRESysNativeManifests", Ci.nsIFile).path,
         ];
         this._lookup = (type, name, context) =>
-          this._tryPaths(type, name, dirs, context);
+          this._tryPaths(
+            type,
+            name,
+            platform == "macosx" &&
+              type == "stdio" &&
+              name == APPLE_PASSWORDS_HOST
+              ? [...dirs, APPLE_PASSWORDS_DIR]
+              : dirs,
+            context
+          );
       } else {
         throw new Error(
           `Native manifests are not supported on ${AppConstants.platform}`
