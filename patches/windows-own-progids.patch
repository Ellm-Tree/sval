   }
 
+  // The service's executable has the same file name as an installed
+  // Firefox's service, so its exit is awaited by process id.
+  nsAutoHandle serviceProcess;
+  SERVICE_STATUS_PROCESS processStatus;
+  DWORD bytesNeeded;
+  if (QueryServiceStatusEx(schService, SC_STATUS_PROCESS_INFO,
+                           reinterpret_cast<LPBYTE>(&processStatus),
+                           sizeof(processStatus), &bytesNeeded) &&
+      processStatus.dwProcessId != 0) {
+    serviceProcess.own(
+        OpenProcess(SYNCHRONIZE, FALSE, processStatus.dwProcessId));
+  }
+
   LOG(("Sending stop request..."));
   SERVICE_STATUS status;
   SetLastError(ERROR_SUCCESS);
