 #include "nsPIDOMWindow.h"
 #include "nsTArray.h"
 #include "nsVariant.h"
@@ -188,6 +189,20 @@ void Gamepad::SyncState(Gamepad* aOther) {
   UpdateTimestamp();
 }
 
+void Gamepad::GetId(nsAString& aID) const {
+  // A standard mapping already tells a page every button's meaning, so the
+  // device name adds nothing a game needs.
+  if (mMapping == GamepadMappingType::Standard) {
+    nsCOMPtr<nsIGlobalObject> global = do_QueryInterface(mParent);
+    if (global &&
+        global->ShouldResistFingerprinting(RFPTarget::GamepadIdGeneric)) {
+      aID.AssignLiteral("Standard Gamepad");
+      return;
+    }
+  }
+  aID = mID;
+}
