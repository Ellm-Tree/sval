   handleArrowKeyDown(event, browser) {
+    let group = event.composedTarget?.closest?.("moz-button-group");
+    if (group && ["ArrowLeft", "ArrowRight"].includes(event.key)) {
+      let buttons = [...group.children];
+      let step = event.key === "ArrowRight" ? 1 : -1;
+      if (group.matches(":dir(rtl)")) {
+        step = -step;
+      }
+      let index = buttons.indexOf(event.composedTarget);
+      buttons[(index + step + buttons.length) % buttons.length].focus({
+        focusVisible: true,
+      });
+      event.preventDefault();
+      return;
+    }
