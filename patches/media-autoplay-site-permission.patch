+// Under media.autoplay.site-permission-only, only ALLOW or a trait lets media
+// play, whatever the user pressed: the top-level site's own permission, or for
+// a site with none the one media.autoplay.site-permission-only.default gives
+// every such site.
+static bool IsWindowAllowedToPlayBySitePermission(nsPIDOMWindowInner* aWindow) {
+  const uint32_t perm = SiteAutoplayPerm(aWindow);
+  if (perm == nsIPermissionManager::ALLOW_ACTION ||
+      (perm == nsIPermissionManager::UNKNOWN_ACTION &&
+       StaticPrefs::media_autoplay_site_permission_only_default() == 1)) {
+    AUTOPLAY_LOG("Allow autoplay as the site has autoplay permission.");
+    return true;
+  }
+  return IsWindowAllowedToPlayByTraits(aWindow);
+}
