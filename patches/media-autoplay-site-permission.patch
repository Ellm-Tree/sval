diff --git a/toolkit/actors/AutoplayChild.sys.mjs b/toolkit/actors/AutoplayChild.sys.mjs
index 2bbfd22f0..e103a524a 100644
--- a/toolkit/actors/AutoplayChild.sys.mjs
+++ b/toolkit/actors/AutoplayChild.sys.mjs
@@ -3,7 +3,15 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
 export class AutoplayChild extends JSWindowActorChild {
-  handleEvent() {
-    this.sendAsyncMessage("GloballyAutoplayBlocked", {});
+  handleEvent(event) {
+    // Sval: whether the user had just interacted with the page, so the front
+    // end can tell a press of play from autoplay, and what tried to play: a
+    // video or an audio element, or, from the document, Web Audio or an
+    // element in no document.
+    const kind = { video: "video", audio: "audio" }[event.target?.localName];
+    this.sendAsyncMessage("GloballyAutoplayBlocked", {
+      userGesture: !!this.document?.hasValidTransientUserGestureActivation,
+      kind: kind ?? "media",
+    });
   }
 }
