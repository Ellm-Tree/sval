Sval: open a site's links in their own tab under Keep links in this tab

A site whose links ask for a new tab, with target=_blank or window.open,
opens a tab on every click. A user who turns on Keep links in this tab for
the site wants those links to load in the tab they are in. Gecko decides
where such a request opens in the content process, in
BrowserChild::ProvideWindow, which already loads it in the current tab under
browser.link.open_newwindow 1. That pref is global, so this adds a
parent-only BrowsingContext field, SvalKeepLinksSite, which Sval's chrome
sets on a tab to the site whose rule is on, and asks Sval's SvalKeepLinks.cpp
whether a request for a new tab takes the current-tab path.

diff --git a/docshell/base/BrowsingContext.h b/docshell/base/BrowsingContext.h
index 340a8f3961..4c48036a33 100644
--- a/docshell/base/BrowsingContext.h
+++ b/docshell/base/BrowsingContext.h
@@ -163,6 +163,11 @@ struct EmbedderColorSchemes {
   /* Sval: whether this tab belongs to an agent's workspace. Set by the parent \
    * on top level browsing contexts only. */                                   \
   FIELD(SvalAgentTab, bool, {.mTopOnly = true, .mCanSet = CanSet::ParentOnly}) \
+  /* Sval: the site whose links that ask for a new tab load in this tab,       \
+   * empty for none (SvalKeepLinks.cpp). Set by the parent on top level        \
+   * browsing contexts only. */                                                \
+  FIELD(SvalKeepLinksSite, nsCString,                                          \
+        {.mTopOnly = true, .mCanSet = CanSet::ParentOnly})                     \
   /* Sval: whether this tab's pages have focus, as in the focused tab of a     \
    * focused window, without the window's. Set by the parent on top level      \
    * browsing contexts only (SvalFocusEmulation.cpp). */                       \
@@ -1247,6 +1252,9 @@ class BrowsingContext : public nsILoadContext, public nsWrapperCache {
 
   bool IsAppTab() { return GetIsAppTab(); }
   bool SvalAgentTab() { return GetSvalAgentTab(); }
+  void GetSvalKeepLinksSite(nsACString& aSite) const {
+    aSite = GetSvalKeepLinksSite();
+  }
   bool SvalFocusEmulated() { return GetSvalFocusEmulated(); }
   bool SvalAgentInControl() { return GetSvalAgentInControl(); }
   // Sval: whether an agent controls the tab aWindow's page is in.
