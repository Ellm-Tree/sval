+bool ChannelWrapper::BlockedFor(const WebExtensionPolicy& aExtension) const {
+  nsAutoCString host;
+  if (Type() == MozContentPolicyType::Main_frame) {
+    host = FinalURLInfo().Host();
+  } else if (nsCOMPtr<nsILoadInfo> loadInfo = GetLoadInfo()) {
+    nsCOMPtr<nsICookieJarSettings> settings;
+    (void)loadInfo->GetCookieJarSettings(getter_AddRefs(settings));
+    SvalTopLevelHost(loadInfo, settings, host);
+  }
+  return aExtension.BlockedOnTopSite(host);
+}
