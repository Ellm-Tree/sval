@@ -56,12 +57,27 @@ def write_defaults(output, defaults_base, defaults_fpp):
     output.write("}\n")
 
 
+def read_with_includes(path):
+    # Sval: RFPTargets.inc includes Sval's targets, which the C++ preprocessor
+    # reads in place, so they are read in place here too.
+    include = re.compile(r'^#include "(.+)"$')
+    contents = ""
+    with open(path) as f:
+        for line in f:
+            match = include.match(line.strip())
+            if match:
+                contents += read_with_includes(
+                    os.path.join(os.path.dirname(path), match.group(1))
+                )
+            else:
+                contents += line
+    return contents
+
