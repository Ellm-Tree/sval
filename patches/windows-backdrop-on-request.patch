--- a/browser/base/content/browser.xhtml
+++ b/browser/base/content/browser.xhtml
@@ -13,7 +13,6 @@
         windowtype="navigator:browser"
         macanimationtype="document"
         macnativefullscreen="true"
-        windowsmica="true"
         screenX="4" screenY="4"
         sizemode="normal"
         retargetdocumentfocus="urlbar-input"
