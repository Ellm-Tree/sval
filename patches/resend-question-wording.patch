Sval: the resend question says what resending does, under its own title

Reloading a page that came from a form asks before sending it again.
Firefox's question names no action in plain words and, opened in a tab,
takes the page's address as its title, which for a failed load is
about:neterror. It passes useTitle, as Settings' own questions do, so the
title is the question. Only asyncConfirmEx carries extra arguments through
nsIPromptService, so the question is asked through it and waited on as
Prompter.openPromptSync waits.

diff --git a/browser/components/prompts/PromptCollection.sys.mjs b/browser/components/prompts/PromptCollection.sys.mjs
index e0bfce3630..847ccd6301 100644
--- a/browser/components/prompts/PromptCollection.sys.mjs
+++ b/browser/components/prompts/PromptCollection.sys.mjs
@@ -22,9 +22,11 @@ export class PromptCollection {
       // That's ok, we'll use a generic version of the prompt
     }
 
+    let title;
     let message;
     let resendLabel;
     try {
+      title = this.stringBundles.app.GetStringFromName("confirmRepostTitle");
       if (brandName) {
         message = this.stringBundles.app.formatStringFromName(
           "confirmRepostPrompt",
@@ -52,17 +54,34 @@ export class PromptCollection {
         Ci.nsIPromptService.BUTTON_POS_0) |
       (Ci.nsIPromptService.BUTTON_TITLE_CANCEL *
         Ci.nsIPromptService.BUTTON_POS_1);
-    let buttonPressed = Services.prompt.confirmExBC(
-      browsingContext,
-      modalType,
-      null,
-      message,
-      buttonFlags,
-      resendLabel,
-      null,
-      null,
-      null,
-      {}
+    let buttonPressed;
+    Services.prompt
+      .asyncConfirmEx(
+        browsingContext,
+        modalType,
+        title,
+        message,
+        buttonFlags,
+        resendLabel,
+        null,
+        null,
+        null,
+        false,
+        { useTitle: true }
+      )
+      .then(
+        result => {
+          buttonPressed = result
+            .QueryInterface(Ci.nsIPropertyBag2)
+            .get("buttonNumClicked");
+        },
+        () => {
+          buttonPressed = 1;
+        }
+      );
+    Services.tm.spinEventLoopUntilOrQuit(
+      "PromptCollection.sys.mjs:confirmRepost",
+      () => buttonPressed !== undefined
     );
 
     return buttonPressed === 0;
