   }
 
   _roundOrResetContentSize(aBrowser, isNewTab = false) {
-    // We won't do anything for lazy browsers.
-    if (!aBrowser?.isConnected) {
+    // We won't do anything for lazy browsers, nor for a browser with no tab:
+    // the preloaded new tab sits in a .browserStack of its own until a tab
+    // adopts it, and TabOpen rounds it then.
+    if (!aBrowser?.isConnected || !aBrowser.getTabBrowser()) {
       return;
     }
     if (this._noLetterBoxingFor(aBrowser)) {
@@ -612,6 +614,11 @@ class _RFPHelper {
   }
 
   _attachWindow(aWindow) {
+    // kPrefResistFingerprinting is a prefix of kPrefLetterboxing, so both
+    // pref observers report a letterboxing change.
+    if (this._resizeObservers.has(aWindow)) {
+      return;
+    }
     aWindow.gBrowser.addTabsProgressListener(this);
     aWindow.addEventListener("TabOpen", this);
     let resizeObserver = new aWindow.ResizeObserver(entries => {
