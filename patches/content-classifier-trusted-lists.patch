+/// Sval: `permissions` holds, for each rule, the adblock-rust permission bits
+/// of the list it came from, so that a scriptlet needing a permission runs
+/// only from a list given it.
 #[no_mangle]
 pub unsafe extern "C" fn content_classifier_engine_from_rules(
     rules: &ThinVec<nsCString>,
+    permissions: &ThinVec<u8>,
     out_engine: *mut *mut ContentClassifierFFIEngine,
 ) -> nsresult {
-    if out_engine.is_null() {
+    if out_engine.is_null() || permissions.len() != rules.len() {
         return NS_ERROR_INVALID_ARG;
     }
 
-    let rules_vec: Vec<String> = rules
-        .iter()
-        .map(|r| String::from_utf8_lossy(r.as_ref()).to_string())
-        .collect();
-
-    let engine = Engine::from_rules(
-        rules_vec,
-        adblock::lists::ParseOptions {
-            ..adblock::lists::ParseOptions::default()
-        },
-    );
+    let mut filter_set = adblock::lists::FilterSet::new(false);
+    let mut start = 0;
+    while start < rules.len() {
+        let bits = permissions[start];
+        let mut end = start + 1;
+        while end < rules.len() && permissions[end] == bits {
+            end += 1;
+        }
+        filter_set.add_filters(
+            rules[start..end]
+                .iter()
+                .map(|r| String::from_utf8_lossy(r.as_ref()).into_owned()),
+            adblock::lists::ParseOptions {
+                permissions: adblock::resources::PermissionMask::from_bits(bits),
+                ..adblock::lists::ParseOptions::default()
+            },
+        );
+        start = end;
+    }
+    let engine = Engine::from_filter_set(filter_set, true);
 
     let boxed_engine = Box::new(ContentClassifierFFIEngine { engine });
     *out_engine = Box::into_raw(boxed_engine);
