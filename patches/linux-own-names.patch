diff --git a/toolkit/crashreporter/crash_helper_server/src/logging/env.rs b/toolkit/crashreporter/crash_helper_server/src/logging/env.rs
index 05cddde..45a5482 100644
--- a/toolkit/crashreporter/crash_helper_server/src/logging/env.rs
+++ b/toolkit/crashreporter/crash_helper_server/src/logging/env.rs
@@ -33,6 +33,13 @@ fn guess_user_app_data_dir() -> Option<PathBuf> {
 
     cfg_if! {
         if #[cfg(target_os = "linux")] {
+            // A build with a profile name keeps its data in a dotted
+            // directory of that name in the home directory
+            // (nsXREDirProvider::AppendProfilePath under MOZ_LEGACY_HOME).
+            if !config::MOZ_APP_PROFILE.is_empty() {
+                return Some(home_dir.join(format!(".{}", config::MOZ_APP_PROFILE.to_lowercase())));
+            }
+
             use std::fs::exists;
 
             let legacy_data = home_dir.join(".mozilla").join(config::MOZ_APP_NAME);
