Sval: about:support fills in when the free disk space cannot be read

`Troubleshoot.sys.mjs`'s application provider is async, so a throw from
`nsIFile.diskSpaceAvailable` (a failed `statfs` on the profile's volume)
escapes `Troubleshoot.snapshot`'s catch as an unhandled rejection, and the
provider never calls back. The snapshot then never resolves: about:support
stays unfilled and Send Feedback's report waits on it. The free space is
read in a try of its own, as the provider reads its other optional fields.

diff --git a/toolkit/modules/Troubleshoot.sys.mjs b/toolkit/modules/Troubleshoot.sys.mjs
index bf64a8647..56409e9b8 100644
--- a/toolkit/modules/Troubleshoot.sys.mjs
+++ b/toolkit/modules/Troubleshoot.sys.mjs
@@ -226,10 +226,17 @@ var dataProviders = {
       ).userAgent,
       safeMode: Services.appinfo.inSafeMode,
       memorySizeBytes: Services.sysinfo.getProperty("memsize"),
-      diskAvailableBytes: Services.dirsvc.get("ProfD", Ci.nsIFile)
-        .diskSpaceAvailable,
     };
 
+    // The disk's free space throws when the profile's volume cannot be
+    // read, and a throw here would leave the snapshot waiting forever.
+    try {
+      data.diskAvailableBytes = Services.dirsvc.get(
+        "ProfD",
+        Ci.nsIFile
+      ).diskSpaceAvailable;
+    } catch (e) {}
+
     if (Services.sysinfo.getProperty("name") == "Windows_NT") {
       if ((await Services.sysinfo.processInfo).isWindowsSMode) {
         data.osVersion += " S";
