diff --git a/widget/cocoa/nsCocoaWindow.mm b/widget/cocoa/nsCocoaWindow.mm
index 098b770057..41b6b6635a 100644
--- a/widget/cocoa/nsCocoaWindow.mm
+++ b/widget/cocoa/nsCocoaWindow.mm
@@ -5636,6 +5636,16 @@ void nsCocoaWindow::Show(bool aState) {
       // displays.
       if ((mAlwaysOnTop && mPiPType != PiPType::DocumentPiP) || mIsAlert) {
         [mWindow orderFront:nil];
+      } else if (std::exchange(mOpenInBackground, false)) {
+        // Sval: behind the app's window in front, or behind every window when
+        // the app has none, neither key nor main, so the app's active window
+        // keeps the keyboard.
+        NSWindow* front = NSApp.keyWindow ?: NSApp.mainWindow;
+        if (front && front != mWindow) {
+          [mWindow orderWindow:NSWindowBelow relativeTo:front.windowNumber];
+        } else {
+          [mWindow orderBack:nil];
+        }
       } else {
         [mWindow makeKeyAndOrderFront:nil];
       }
