+// A toplevel window's backdrop is the compositor's blur of what is behind
+// it, which shows through the parts the window paints translucent.
+void nsWindow::SetMicaBackdrop(bool aEnabled) {
+#ifdef MOZ_WAYLAND
+  if (mWindowType != WindowType::TopLevel || !mSurface) {
+    return;
+  }
+  WaylandSurfaceLock lock(mSurface);
+  mSurface->SetBackgroundBlurLocked(lock, aEnabled);
+#endif
+}
