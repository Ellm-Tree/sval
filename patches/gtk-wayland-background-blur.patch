+// A toplevel or popup window's backdrop is the compositor's blur of what is
+// behind it, which shows through the parts the window paints translucent.
+void nsWindow::SetMicaBackdrop(bool aEnabled) {
+#ifdef MOZ_WAYLAND
+  if (!(mWindowType == WindowType::TopLevel || IsPopup()) || !mSurface) {
+    return;
+  }
+  mBlurBackdrop = aEnabled;
+  WaylandSurfaceLock lock(mSurface);
+  mSurface->SetBackgroundBlurLocked(lock, aEnabled, &mBlurRects);
+#endif
+}
+
+// A popup's blur takes the shape it is given, which a region of rectangles
+// can only approximate: rows of kBlurRow device pixels, each covering the
+// spans the shape's rings fill even-odd across the row's middle.
+void nsWindow::SetWindowShape(const WindowShape& aShape) {
+#ifdef MOZ_WAYLAND
+  static const int kBlurRow = 2;
+  mBlurRects.Clear();
+  if (!aShape.IsEmpty()) {
+    const double scale = FractionalScaleFactor();
+    float bottom = 0;
+    for (const auto& ring : aShape.mRings) {
+      for (const auto& point : ring) {
+        bottom = std::max(bottom, point.y.value);
+      }
+    }
+    for (int y = 0; y < int(bottom); y += kBlurRow) {
+      const float mid = y + kBlurRow / 2.0f;
+      nsTArray<float> crossings;
+      for (const auto& ring : aShape.mRings) {
+        for (size_t i = 0; i < ring.Length(); i++) {
+          const auto& a = ring[i];
+          const auto& b = ring[(i + 1) % ring.Length()];
+          if ((a.y.value <= mid) != (b.y.value <= mid)) {
+            crossings.AppendElement(a.x.value + (mid - a.y.value) *
+                                                    (b.x.value - a.x.value) /
+                                                    (b.y.value - a.y.value));
+          }
+        }
+      }
+      crossings.Sort();
+      for (size_t i = 0; i + 1 < crossings.Length(); i += 2) {
+        const int left = int(floor(crossings[i] / scale));
+        const int right = int(ceil(crossings[i + 1] / scale));
+        const int top = int(floor(y / scale));
+        const int rowBottom = int(ceil((y + kBlurRow) / scale));
+        mBlurRects.AppendElement(
+            gfx::IntRect(left, top, right - left, rowBottom - top));
+      }
+    }
+  }
+  if (!mSurface || !(mWindowType == WindowType::TopLevel || IsPopup())) {
+    return;
+  }
+  WaylandSurfaceLock lock(mSurface);
+  mSurface->SetBackgroundBlurLocked(lock, mBlurBackdrop, &mBlurRects);
+#endif
+}
+
+bool nsWindow::HasWindowShape() const {
+#ifdef MOZ_WAYLAND
+  return mBlurBackdrop && !mBlurRects.IsEmpty();
+#else
+  return false;
+#endif
+}
