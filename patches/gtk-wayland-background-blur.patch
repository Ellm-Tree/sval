+void WaylandSurface::SetBackgroundBlurLocked(
+    const WaylandSurfaceLock& aProofOfLock, bool aBlur,
+    const nsTArray<gfx::IntRect>* aRects) {
+  MOZ_DIAGNOSTIC_ASSERT(&aProofOfLock == mSurfaceLock);
+  auto* manager = WaylandDisplayGet()->GetBackgroundEffectManager();
+  if (!manager || (!aBlur && !mBackgroundEffect)) {
+    return;
+  }
+  LOGWAYLAND("WaylandSurface::SetBackgroundBlurLocked() %d", aBlur);
+  if (!mBackgroundEffect) {
+    mBackgroundEffect = ext_background_effect_manager_v1_get_background_effect(
+        manager, mSurface);
+  }
+  wl_region* region = nullptr;
+  if (aBlur) {
+    region = wl_compositor_create_region(WaylandDisplayGet()->GetCompositor());
+    if (aRects && !aRects->IsEmpty()) {
+      for (const auto& rect : *aRects) {
+        wl_region_add(region, rect.x, rect.y, rect.width, rect.height);
+      }
+    } else {
+      // The compositor clips the region to the surface, so one region covers
+      // the surface at every size.
+      wl_region_add(region, 0, 0, INT32_MAX, INT32_MAX);
+    }
+  }
+  ext_background_effect_surface_v1_set_blur_region(mBackgroundEffect, region);
+  if (region) {
+    wl_region_destroy(region);
+  }
+  mSurfaceNeedsCommit = true;
+}
