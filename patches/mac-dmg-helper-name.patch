Sval: name the macOS disk image helper after the Gecko an artifact build runs on

Sval labels the disk image installer's privileged helper with its own
identifier, and an artifact build on Mozilla's Gecko unpacks Mozilla's
package, whose helper is org.mozilla.dmgInstallHelper. Naming it from
MOZ_APP_NAME, as helper_names does the other helpers, lets that build find
it.

diff --git a/browser/app/Makefile.in b/browser/app/Makefile.in
index cda4be6ee7..c03699c8f4 100644
--- a/browser/app/Makefile.in
+++ b/browser/app/Makefile.in
@@ -88,7 +88,7 @@ tools repackage:: $(DIST)/bin/$(MOZ_APP_NAME) $(objdir)/macbuild/Contents/MacOS-
 ifdef MOZ_UPDATER
 	cp -f '$(dist_dest)/Contents/MacOS/updater.app/Contents/MacOS/$(MOZ_UPDATER_NAME)' '$(dist_dest)/Contents/Library/LaunchServices/app.sval.updater'
 endif
-	mv '$(dist_dest)/Contents/Resources/app.sval.dmgInstallHelper' '$(dist_dest)/Contents/Library/LaunchServices'
+	mv '$(dist_dest)/Contents/Resources/$(MOZ_DMG_INSTALL_HELPER_NAME)' '$(dist_dest)/Contents/Library/LaunchServices'
 	$(MKDIR) -p '$(dist_dest)/Contents/Frameworks'
 	mv '$(dist_dest)/Contents/Resources/ChannelPrefs.framework' '$(dist_dest)/Contents/Frameworks'
 	printf APPLMOZB > '$(dist_dest)/Contents/PkgInfo'
