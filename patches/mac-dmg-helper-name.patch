diff --git a/toolkit/moz.configure b/toolkit/moz.configure
index 7bde9e2504..89c3ad3e0e 100644
--- a/toolkit/moz.configure
+++ b/toolkit/moz.configure
@@ -3403,6 +3403,17 @@ helper_name("MOZ_V4L2TEST_NAME", "v4l2-test")
 helper_name("MOZ_VULKANTEST_NAME", "vulkan-test")
 
 
+# The disk image installer's privileged helper is labelled with the
+# application's identifier, and Mozilla's packages carry org.mozilla's.
+@depends(moz_app_name, "--with-distribution-id")
+def dmg_install_helper_name(app_name, distribution_id):
+    prefix = "org.mozilla" if app_name == "firefox" else distribution_id[0]
+    return f"{prefix}.dmgInstallHelper"
+
+
+set_config("MOZ_DMG_INSTALL_HELPER_NAME", dmg_install_helper_name)
+
+
 # Child Process Name for IPC
 # ==============================================================
 @depends(toolkit, bin_suffix(target), helper_names)
