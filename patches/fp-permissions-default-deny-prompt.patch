+/* static */
+bool PermissionDelegateHandler::IsDefaultDeny(
+    nsIPermissionManager* aPermissionManager, nsIPrincipal* aPrincipal,
+    const nsACString& aType, bool aExactHostMatch) {
+  if (!aPermissionManager || !aPrincipal) {
+    return false;
+  }
+  nsCOMPtr<nsIPermission> entry;
+  uint32_t permission = nsIPermissionManager::UNKNOWN_ACTION;
+  return NS_SUCCEEDED(aPermissionManager->GetPermissionObject(
+             aPrincipal, aType, aExactHostMatch, getter_AddRefs(entry))) &&
+         !entry &&
+         NS_SUCCEEDED(
+             aExactHostMatch
+                 ? aPermissionManager->TestExactPermissionFromPrincipal(
+                       aPrincipal, aType, &permission)
+                 : aPermissionManager->TestPermissionFromPrincipal(
+                       aPrincipal, aType, &permission)) &&
+         permission == nsIPermissionManager::DENY_ACTION;
+}
