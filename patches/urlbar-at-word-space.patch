   UrlbarResult: "chrome://browser/content/urlbar/UrlbarResult.mjs",
   UrlbarSearchUtils:
     "moz-src:///browser/components/urlbar/UrlbarSearchUtils.sys.mjs",
@@ -61,6 +63,12 @@ export class UrlbarProviderAliasEngines extends UrlbarProvider {
