Sval: libsecret reconnects to a Secret Service that restarted

libsecret keeps one connection to the Secret Service per process, bound to
the daemon that first answered. When that daemon goes away, every later call
fails, even once a new daemon owns org.freedesktop.secrets, so a keyring
restart while Sval runs leaves every secret unreadable until Sval restarts.
Dropping the connection after a failed call (secret_service_disconnect)
makes the next call connect to whichever daemon answers then.

diff --git a/security/manager/ssl/LibSecret.cpp b/security/manager/ssl/LibSecret.cpp
index bd47dfe6c8..88bd5f6438 100644
--- a/security/manager/ssl/LibSecret.cpp
+++ b/security/manager/ssl/LibSecret.cpp
@@ -75,12 +75,14 @@ typedef gboolean (*secret_password_store_sync_fn)(const SecretSchema*,
                                                   GError**, ...);
 typedef void (*secret_password_free_fn)(const gchar*);
 typedef GQuark (*secret_error_get_quark_fn)();
+typedef void (*secret_service_disconnect_fn)();
 
 static secret_password_clear_sync_fn secret_password_clear_sync = nullptr;
 static secret_password_lookup_sync_fn secret_password_lookup_sync = nullptr;
 static secret_password_store_sync_fn secret_password_store_sync = nullptr;
 static secret_password_free_fn secret_password_free = nullptr;
 static secret_error_get_quark_fn secret_error_get_quark = nullptr;
+static secret_service_disconnect_fn secret_service_disconnect = nullptr;
 
 nsresult MaybeLoadLibSecret() {
   MOZ_ASSERT(NS_IsMainThread());
@@ -122,6 +124,10 @@ nsresult MaybeLoadLibSecret() {
   FIND_FUNCTION_SYMBOL(secret_password_free);
   FIND_FUNCTION_SYMBOL(secret_error_get_quark);
 #undef FIND_FUNCTION_SYMBOL
+  // Optional: a libsecret without it keeps a lost connection lost.
+  secret_service_disconnect =
+      (secret_service_disconnect_fn)PR_FindFunctionSymbol(
+          libsecret, "secret_service_disconnect");
 
   return NS_OK;
 }
@@ -144,6 +150,16 @@ struct ScopedMaybeDelete {
 
 typedef std::unique_ptr<char, ScopedMaybeDelete<char>> ScopedPassword;
 
+// libsecret keeps one connection to the Secret Service for the process, bound
+// to the daemon that answered first. Once that daemon is gone every call fails,
+// even after a new one starts, until the connection is dropped; the next call
+// then connects again.
+static void DropSecretServiceAfter(const GUniquePtr<GError>& error) {
+  if (error && secret_service_disconnect) {
+    secret_service_disconnect();
+  }
+}
+
 LibSecret::LibSecret() = default;
 
 LibSecret::~LibSecret() {
@@ -157,6 +173,7 @@ LibSecret::~LibSecret() {
     secret_password_store_sync = nullptr;
     secret_password_free = nullptr;
     secret_error_get_quark = nullptr;
+    secret_service_disconnect = nullptr;
     UNLOAD_LIBSECRET(libsecret);
     libsecret = nullptr;
   }
@@ -189,6 +206,7 @@ nsresult LibSecret::StoreSecret(const nsACString& aSecret,
       nullptr,  // GCancellable
       getter_Transfers(error), "string", PromiseFlatCString(aLabel).get(),
       nullptr);
+  DropSecretServiceAfter(error);
   if (error) {
     MOZ_LOG(gLibSecretLog, LogLevel::Debug, ("Error storing secret"));
     return NS_ERROR_FAILURE;
@@ -210,6 +228,7 @@ nsresult LibSecret::DeleteSecret(const nsACString& aLabel) {
   if (error && !(error->domain == secret_error_get_quark() &&
                  error->code == SECRET_ERROR_NO_SUCH_OBJECT)) {
     MOZ_LOG(gLibSecretLog, LogLevel::Debug, ("Error deleting secret"));
+    DropSecretServiceAfter(error);
     return NS_ERROR_FAILURE;
   }
 
@@ -229,6 +248,7 @@ nsresult LibSecret::RetrieveSecret(const nsACString& aLabel,
                                   nullptr,  // GCancellable
                                   getter_Transfers(error), "string",
                                   PromiseFlatCString(aLabel).get(), nullptr));
+  DropSecretServiceAfter(error);
   if (error) {
