       *mActiveMediaSessionContextId != aBrowsingContextId) {
     return;
   }
-  mPositionStateChangedEvent.Notify(aState);
+  // Sval: as GetCurrentPositionState, nothing for a private tab.
+  mPositionStateChangedEvent.Notify(IsInPrivateBrowsing() ? Nothing() : aState);
 }
 
