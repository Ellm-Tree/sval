+/* static */
+bool Scriptability::AllowedByPolicy(nsIPrincipal* aPrincipal) {
+  if (PrincipalImmuneToScriptPolicy(aPrincipal)) {
+    return true;
+  }
+  bool policyAllows = false;
+  return NS_SUCCEEDED(aPrincipal->GetIsScriptAllowedByPolicy(&policyAllows)) &&
+         policyAllows;
+}
