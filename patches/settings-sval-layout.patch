+  ["general-translations", { category: "sync", subcategory: "translations" }],
+  // Sval's cards in Privacy and protection replace Enhanced Tracking
+  // Protection's pages, and its advanced tracking settings hold the prefs
+  // they reached.
+  [
+    "privacy-trackingprotection",
+    { category: "privacy", subcategory: "tracking" },
+  ],
+  ["etp", { category: "privacy", subcategory: "tracking" }],
+  ["etpCustomize", { category: "privacy", subcategory: "tracking" }],
+  ["privacy-doh", { category: "privacy", subcategory: "secureDns" }],
+  ["dnsOverHttps", { category: "privacy", subcategory: "secureDns" }],
+  // Sval's Protections category is part of Privacy and protection, but for
+  // its list of sites, which is Sites (Sval decision 1484).
+  ["svalProtections", { category: "privacy" }],
+  [
+    "svalProtections-tracking",
+    { category: "privacy", subcategory: "tracking" },
+  ],
+  [
+    "svalProtections-secureDns",
+    { category: "privacy", subcategory: "secureDns" },
+  ],
+  ["svalProtections-sites", { category: "svalSites", subcategory: "sites" }],
+  // Sites holds the permission defaults, and each site's page its
+  // permissions (Sval decision 1484).
+  ["permissionsData", { category: "svalSites" }],
+  ["privacy-permissions", { category: "svalSites" }],
+  ["privacy-permissions-block-popups", { category: "svalSites" }],
 ]);
 
