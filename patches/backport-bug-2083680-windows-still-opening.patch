Sval: skip browser windows still opening when counting their tabs

Backport of Mozilla's Bug 2083680 (mozilla-firefox/firefox 7706138007c8,
D335273), without its test. The ESR 153.5.1 pin does not carry it.
The window mediator lists a new browser window before its gBrowser
exists, so BrowserTelemetryUtils.computeSiteOriginCount, which runs at
idle after a page load stops, and BrowserUsageTelemetry's tab counts threw
a TypeError whenever they ran while another window was opening. The
error reaches the console, where a browser-chrome test that fails on
console errors reads it. Drop this patch when the upstream pin carries
7706138007c8.

diff --git a/browser/modules/BrowserUsageTelemetry.sys.mjs b/browser/modules/BrowserUsageTelemetry.sys.mjs
index 4423ae0dd9..3fd122a4f7 100644
--- a/browser/modules/BrowserUsageTelemetry.sys.mjs
+++ b/browser/modules/BrowserUsageTelemetry.sys.mjs
@@ -276,6 +276,10 @@ function getOpenTabsAndWinsCounts() {
 
   for (let win of Services.wm.getEnumerator("navigator:browser")) {
     winCount++;
+    // Windows that are still opening don't have a gBrowser yet.
+    if (!win.gBrowser) {
+      continue;
+    }
     tabCount += win.gBrowser.tabs.length;
     for (const tab of win.gBrowser.tabs) {
       if (tab.getAttribute("pending") !== "true") {
@@ -303,6 +307,9 @@ function getPinnedTabsCount() {
   let pinnedTabs = 0;
 
   for (let win of Services.wm.getEnumerator("navigator:browser")) {
+    if (!win.gBrowser) {
+      continue;
+    }
     pinnedTabs += [...win.gBrowser.tabs].filter(t => t.pinned).length;
   }
 
@@ -1565,6 +1572,9 @@ export let BrowserUsageTelemetry = {
     let tabGroupLengths = [];
 
     for (let win of Services.wm.getEnumerator("navigator:browser")) {
+      if (!win.gBrowser) {
+        continue;
+      }
       totalTabs += win.gBrowser.tabs.length;
       for (let group of win.gBrowser.tabGroups) {
         totalTabsInGroups += group.tabs.length;
@@ -1611,6 +1621,9 @@ export let BrowserUsageTelemetry = {
       collapsed = 0;
 
     for (let win of Services.wm.getEnumerator("navigator:browser")) {
+      if (!win.gBrowser) {
+        continue;
+      }
       for (let group of win.gBrowser.tabGroups) {
         if (group.collapsed) {
           collapsed += 1;
diff --git a/toolkit/modules/BrowserTelemetryUtils.sys.mjs b/toolkit/modules/BrowserTelemetryUtils.sys.mjs
index 210bcd98f3..4eb4ce5a2a 100644
--- a/toolkit/modules/BrowserTelemetryUtils.sys.mjs
+++ b/toolkit/modules/BrowserTelemetryUtils.sys.mjs
@@ -20,7 +20,10 @@ export var BrowserTelemetryUtils = {
       tabs = aWindows;
     } else {
       for (const win of aWindows) {
-        tabs = tabs.concat(win.gBrowser.tabs);
+        // Windows that are still opening don't have a gBrowser yet.
+        if (win.gBrowser) {
+          tabs = tabs.concat(win.gBrowser.tabs);
+        }
       }
     }
 
