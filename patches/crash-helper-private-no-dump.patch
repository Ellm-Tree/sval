+/* Sval: message used to tell the crash helper whether private browsing is in
+ * use, which decides the processes it writes a minidump of. */
+
+pub struct SetPrivateBrowsing {
+    pub private: bool,
+}
+
+impl SetPrivateBrowsing {
+    pub fn new(private: bool) -> SetPrivateBrowsing {
+        SetPrivateBrowsing { private }
+    }
+}
+
+impl Message for SetPrivateBrowsing {
+    fn kind() -> Kind {
+        Kind::SetPrivateBrowsing
+    }
+
+    fn payload_size(&self) -> usize {
+        size_of::<u8>()
+    }
+
+    fn ancillary_data_len(&self) -> usize {
+        0
+    }
+
+    fn encode(self) -> (Bytes, Bytes, Vec<AncillaryData>) {
+        let header = Header::encode(Self::kind(), self.payload_size());
+        let mut payload = BytesMut::with_capacity(self.payload_size());
+        payload.put_u8(self.private.into());
+
+        (header, payload.freeze(), vec![])
+    }
+
+    fn decode(data: Vec<u8>, ancillary_data: Vec<AncillaryData>) -> Result<Self, MessageError> {
+        if !ancillary_data.is_empty() {
+            return Err(MessageError::UnexpectedAncillaryData);
+        }
+
+        let mut data = Bytes::from(data);
+        let private = data.try_get_u8()? != 0;
+
+        Ok(SetPrivateBrowsing { private })
+    }
+}
