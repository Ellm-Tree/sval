 set_config("MOZ_APP_REMOTINGNAME", moz_app_remotingname)
 
 
+# Helper executable names
+# ==============================================================
+# A process name is what killall, pkill and taskkill select by, and pkill
+# matches any part of it. So an application other than Firefox names each of
+# its helpers after itself, in a name that contains no Firefox helper's name.
+# Firefox keeps Mozilla's names, which an artifact build on Mozilla's packages
+# looks for.
+@depends(moz_app_name)
+def helper_names(app_name):
+    mozilla = {
+        "child": "plugin-container",
+        "crash-helper": "crashhelper",
+        "crash-reporter": "crashreporter",
+        "update": "updater",
+        "update-service": "maintenanceservice",
+        "update-service-installer": "maintenanceservice_installer",
+        "private-browsing": "private_browsing",
+        "default-agent": "default-browser-agent",
+        "glx-test": "glxtest",
+        "vaapi-test": "vaapitest",
+        "v4l2-test": "v4l2test",
+        "vulkan-test": "vulkantest",
+    }
+    if app_name == "firefox":
+        return mozilla
+    return {role: f"{app_name}-{role}" for role in mozilla}
+
+
+@template
+def helper_name(var, role):
+    set_config(var, depends(helper_names)(lambda names: names[role]))
+
+
+helper_name("MOZ_CRASHHELPER_NAME", "crash-helper")
+helper_name("MOZ_CRASHREPORTER_NAME", "crash-reporter")
+helper_name("MOZ_UPDATER_NAME", "update")
+helper_name("MOZ_MAINTENANCESERVICE_NAME", "update-service")
+helper_name("MOZ_MAINTENANCESERVICE_INSTALLER_NAME", "update-service-installer")
+helper_name("MOZ_PRIVATE_BROWSING_NAME", "private-browsing")
+helper_name("MOZ_DEFAULT_AGENT_NAME", "default-agent")
+helper_name("MOZ_GLXTEST_NAME", "glx-test")
+helper_name("MOZ_VAAPITEST_NAME", "vaapi-test")
+helper_name("MOZ_V4L2TEST_NAME", "v4l2-test")
+helper_name("MOZ_VULKANTEST_NAME", "vulkan-test")
+
+
 # Child Process Name for IPC
 # ==============================================================
-@depends(toolkit, bin_suffix(target))
-def moz_child_process_name(toolkit, bin_suffix):
