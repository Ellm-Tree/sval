+def moz_child_process_name(toolkit, bin_suffix, helper_names):
     if toolkit != "android":
-        return f"plugin-container{bin_suffix}"
+        return helper_names["child"] + bin_suffix
     else:
         # We want to let Android unpack the file at install time, but it only
