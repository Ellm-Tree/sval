+/**
+ * Sval: the workspace of the browser aBrowserId names, or void when it is in
+ * none, as nsISvalVisitWorkspaces answers it.
+ */
+static void SvalWorkspaceOf(uint64_t aBrowserId, nsCString& aWorkspace) {
+  aWorkspace.SetIsVoid(true);
+  if (!aBrowserId) {
+    return;
+  }
+  RefPtr<dom::BrowsingContext> top =
+      dom::BrowsingContext::GetCurrentTopByBrowserId(aBrowserId);
+  if (!top) {
+    return;
+  }
+  RefPtr<dom::Element> browser = top->Canonical()->GetEmbedderElement();
+  nsCOMPtr<nsISvalVisitWorkspaces> visits =
+      do_GetService("@sval/visit-workspaces;1");
+  if (!browser || !visits ||
+      NS_FAILED(visits->WorkspaceOfBrowser(browser, aWorkspace)) ||
+      aWorkspace.IsEmpty()) {
+    aWorkspace.SetIsVoid(true);
+  }
+}
