Sval: no crash dump is kept until every private content process has exited

SvalCrashPrivacy's flag cleared in the parent process as the last private
browsing context went away, while the content processes that showed the
private pages were still shutting down, and the GPU, RDD, socket and
utility processes still served them. A crash in that gap kept its
minidump.

ContentParent tells SvalCrashPrivacy of each content process whose remote
type is a private one, when the process gets that type and when its actor
is destroyed, and the flag stays set while one is alive. So
CreateMinidumpsAndPair, which refuses while the flag is set, refuses a
hung target whose remote type is private.

diff --git a/dom/ipc/ContentParent.cpp b/dom/ipc/ContentParent.cpp
index f1d7a74b6a..0d3e534f95 100644
--- a/dom/ipc/ContentParent.cpp
+++ b/dom/ipc/ContentParent.cpp
@@ -72,6 +72,7 @@
 #include "mozilla/StyleSheet.h"
 #include "mozilla/StyleSheetInlines.h"
 #include "mozilla/SvalAgentFiles.h"
+#include "mozilla/SvalCrashPrivacy.h"
 #include "mozilla/TaskController.h"
 #include "mozilla/Telemetry.h"
 #include "mozilla/TelemetryComms.h"
@@ -968,6 +969,8 @@ UniqueContentParentKeepAlive ContentParent::GetUsedBrowserProcess(
     preallocated->LoadedOrigins()->SetRemoteType(preallocated->mRemoteType);
     preallocated->mRemoteTypeIsolationPrincipal =
         CreateRemoteTypeIsolationPrincipal(aRemoteType);
+    SvalCrashPrivacy::ContentProcessStarted(
+        preallocated->mRemoteTypeIsolationPrincipal, preallocated->mChildID);
     preallocated->AddToPool(aContentParents);
 
     // rare, but will happen
@@ -2136,6 +2139,10 @@ void ContentParent::ActorDestroy(ActorDestroyReason why) {
 
   mPendingLoadStates.Clear();
   mPendingParentProcessChannelHandles.Clear();
+
+  // Sval: after the process's browsing contexts are discarded above, so the
+  // no-minidump state ends once, with the last of the two.
+  SvalCrashPrivacy::ContentProcessExited(mChildID);
 }
 
 UniqueContentParentKeepAlive ContentParent::TryAddKeepAlive(
@@ -2679,6 +2686,8 @@ ContentParent::ContentParent(const nsACString& aRemoteType)
 
   mRemoteTypeIsolationPrincipal =
       CreateRemoteTypeIsolationPrincipal(aRemoteType);
+  SvalCrashPrivacy::ContentProcessStarted(mRemoteTypeIsolationPrincipal,
+                                          mChildID);
 
   // Insert ourselves into the global linked list of ContentParent objects.
   if (!sContentParents) {
@@ -2711,6 +2720,10 @@ ContentParent::~ContentParent() {
 
   AssertIsOnMainThread();
 
+  // Sval: a launch that failed (LaunchSubprocessReject) opened no channel,
+  // so ActorDestroy never ran.
+  SvalCrashPrivacy::ContentProcessExited(mChildID);
+
   // Clear the weak reference from the threadsafe handle back to this actor.
   mThreadsafeHandle->mWeakActor = nullptr;
 
