+// Sval: held by an UpdateFeatures pass's closures. The last reference goes
+// once the pass has installed its engines, or when its closures are dropped
+// unrun, and tells the service on the main thread.
+class EnginesPassToken final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(EnginesPassToken)
+
+  explicit EnginesPassToken(ContentClassifierService* aService)
+      : mService(aService) {}
+
+ private:
+  ~EnginesPassToken() {
+    NS_DispatchToMainThread(NS_NewRunnableFunction(
+        "ContentClassifierService::EnginesPassEnded",
+        [service = std::move(mService)]() { service->EnginesPassEnded(); }));
+  }
+
+  RefPtr<ContentClassifierService> mService;
+};
