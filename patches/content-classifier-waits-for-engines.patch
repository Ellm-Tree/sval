+
+// Sval
+void ContentClassifierService::CallWhenEnginesReady(
+    already_AddRefed<nsIRunnable> aRunnable) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCOMPtr<nsIRunnable> runnable = aRunnable;
+  if (mEnginesReady) {
+    runnable->Run();
     return;
   }
+  mWaitingForEngines.AppendElement(std::move(runnable));
+}
+
+// Sval
+void ContentClassifierService::EnginesPassEnded() {
+  MOZ_ASSERT(NS_IsMainThread());
+  MOZ_ASSERT(mEnginesPassesInFlight > 0);
+  --mEnginesPassesInFlight;
+  MaybeSetEnginesReady();
+}
+
+// Sval
+void ContentClassifierService::MaybeSetEnginesReady() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mEnginesReady && mInitialImportIssued && !mEnginesPassesInFlight) {
+    SetEnginesReady();
+  }
+}
+
+// Sval
+void ContentClassifierService::SetEnginesReady() {
+  MOZ_ASSERT(NS_IsMainThread());
+  mEnginesReady = true;
+  nsTArray<nsCOMPtr<nsIRunnable>> waiting = std::move(mWaitingForEngines);
+  for (const auto& runnable : waiting) {
+    runnable->Run();
+  }
 }
 
