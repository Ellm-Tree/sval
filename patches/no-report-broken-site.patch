Sval: turn off Report Broken Site

Reports go to webcompat.com, a Mozilla service (spec §10.9). The command
and the Help menu item start hidden: Firefox hides them only once a menu
opens (`ReportBrokenSite.enableOrDisableMenuitems`), and a menuitem takes no
attribute from its command.

diff --git a/browser/components/reportbrokensite/ReportBrokenSite.sys.mjs b/browser/components/reportbrokensite/ReportBrokenSite.sys.mjs
index b5843868e7..c1d63cc088 100644
--- a/browser/components/reportbrokensite/ReportBrokenSite.sys.mjs
+++ b/browser/components/reportbrokensite/ReportBrokenSite.sys.mjs
@@ -666,7 +666,8 @@ export var ReportBrokenSite = new (class ReportBrokenSite {
     // Altering the disabled attribute on the command does not propagate
     // the change to the related menuitems (see bug 805653), so we change them all.
     const cmd = document.getElementById("cmd_reportBrokenSite");
-    const allowedByPolicy = Services.policies.isAllowed("feedbackCommands");
+    // Sval: reports go to webcompat.com, a Mozilla service (Sval spec §10.9).
+    const allowedByPolicy = false;
     cmd.toggleAttribute("hidden", !allowedByPolicy);
     const app = document.documentGlobal.PanelMultiView.getViewNode(
       document,
diff --git a/browser/base/content/browser-menubar.inc.xhtml b/browser/base/content/browser-menubar.inc.xhtml
index d6df5932dc..76c06da443 100644
--- a/browser/base/content/browser-menubar.inc.xhtml
+++ b/browser/base/content/browser-menubar.inc.xhtml
@@ -455,6 +455,7 @@
                           />
                 <menuitem id="help_reportBrokenSite"
                           command="cmd_reportBrokenSite"
+                          hidden="true"
                           data-l10n-id="menu-report-broken-site"
                           disabled="true"
                           appmenu-data-l10n-id="appmenuitem-report-broken-site"/>
diff --git a/browser/base/content/browser-sets.inc.xhtml b/browser/base/content/browser-sets.inc.xhtml
index 7543a6726a..af26cba085 100644
--- a/browser/base/content/browser-sets.inc.xhtml
+++ b/browser/base/content/browser-sets.inc.xhtml
@@ -53,7 +53,7 @@
 #ifdef XP_MACOSX
     <command id="cmd_findSelection" />
 #endif
-    <command id="cmd_reportBrokenSite"/>
+    <command id="cmd_reportBrokenSite" hidden="true"/>
     <command id="cmd_translate" />
     <command id="cmd_openAboutTranslations" />
     <!-- work-around bug 392512 -->
