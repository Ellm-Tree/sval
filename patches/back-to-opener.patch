Sval: Back on a tab another tab opened closes it and shows its opener

A tab opened from a link or by window.open starts with no page to go
back to, so Firefox leaves Back disabled there. Sval enables Back on such
a tab: it closes the tab and selects the tab that opened it, as Safari
does. SvalBackToOpener decides when Back does this, for the Back command,
the Back command's state and the history swipe.

diff --git a/browser/base/content/browser-commands.js b/browser/base/content/browser-commands.js
index 8684b60db3..2a99e6913a 100644
--- a/browser/base/content/browser-commands.js
+++ b/browser/base/content/browser-commands.js
@@ -13,6 +13,14 @@ var BrowserCommands = {
     const where = BrowserUtils.whereToOpenLink(aEvent, false, true);
 
     if (where == "current") {
+      // Sval: a tab another tab opened closes back to it (SvalBackToOpener).
+      if (
+        ChromeUtils.importESModule(
+          "moz-src:///browser/components/sval/SvalBackToOpener.sys.mjs"
+        ).backToOpener(gBrowser.selectedTab)
+      ) {
+        return;
+      }
       try {
         gBrowser.goBack();
       } catch (ex) {}
