diff --git a/docshell/test/browser/browser_backforward_userinteraction_systemprincipal.js b/docshell/test/browser/browser_backforward_userinteraction_systemprincipal.js
index 496c4b7a5c..d6aad704e9 100644
--- a/docshell/test/browser/browser_backforward_userinteraction_systemprincipal.js
+++ b/docshell/test/browser/browser_backforward_userinteraction_systemprincipal.js
@@ -105,3 +105,48 @@ add_task(async function test_urlBar() {
     await loaded;
   });
 });
+
+// Same thing for a load that switches process, where the entry being left and
+// the entry being created belong to different content processes.
+add_task(async function test_process_switch() {
+  await SpecialPowers.pushPrefEnv({
+    set: [
+      ["browser.navigation.requireUserInteraction", true],
+      ["browser.newtab.preload", false],
+      ["browser.tabs.remote.separatePrivilegedContentProcess", true],
+    ],
+  });
+
+  let tab = await BrowserTestUtils.openNewForegroundTab(
+    gBrowser,
+    "about:newtab"
+  );
+  let browser = tab.linkedBrowser;
+  assertBackForwardState(false, false);
+  let privilegedPid = browser.frameLoader.remoteTab.osPid;
+
+  info(`Loading ${TEST_PAGE} from the browser chrome.`);
+  let loaded = BrowserTestUtils.browserLoaded(browser, false, TEST_PAGE);
+  BrowserTestUtils.startLoadingURIString(browser, TEST_PAGE);
+  await loaded;
+
+  isnot(
+    browser.frameLoader.remoteTab.osPid,
+    privilegedPid,
+    "The load should have switched process, otherwise this is a duplicate of " +
+      "the test above."
+  );
+
+  let sh = browser.browsingContext.sessionHistory;
+  ok(
+    sh.getEntryAtIndex(sh.index - 1).hasUserInteraction,
+    "The entry we navigated away from should have user interaction."
+  );
+  ok(
+    !sh.getEntryAtIndex(sh.index).hasUserInteraction,
+    "The entry this load created should not have user interaction."
+  );
+  assertBackForwardState(true, false);
+
+  BrowserTestUtils.removeTab(tab);
+});
