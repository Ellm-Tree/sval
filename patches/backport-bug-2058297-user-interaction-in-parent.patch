Sval: mark the entry a chrome-initiated load leaves in the triggering process

Backport of Mozilla's D314488 (Bug 2058297, diff 2 of 2026-07-29, r+ smaug,
not landed). The ESR 153.5.0 pin does not carry it. Its hunk in
browser_new_tab_in_privilegedabout_process_pref.js is left out, because the
workaround it removes is not in the pin; the rest applies unchanged.
A load with a system triggering principal, such as one from the address bar,
counts as user interaction with the entry it leaves, so that
browser.navigation.requireUserInteraction lets Back return to it.
nsDocShell::LoadURI set that flag in the content process. When the old page's
process was running a script, the flag arrived after the new entry was
active, or never, because ContentChild::RecvLoadURI drops a load whose
BrowsingContext has left the process, and Back was disabled.
BrowsingContext::MaybeSetSHEntryHasUserInteraction sets it in the process
that triggers the load, from BrowsingContext::LoadURI and
BrowserParent::LoadURL, and nsDocShell::LoadURI skips it once set. Drop this
patch when Bug 2058297 lands and reaches the upstream pin's ESR.

diff --git a/docshell/base/BrowsingContext.cpp b/docshell/base/BrowsingContext.cpp
index e7b3a6c80f..c55cbbd997 100644
--- a/docshell/base/BrowsingContext.cpp
+++ b/docshell/base/BrowsingContext.cpp
@@ -2383,6 +2383,8 @@ nsresult BrowsingContext::LoadURI(nsDocShellLoadState* aLoadState,
     }
   } else if (XRE_IsParentProcess()) {
     if (ContentParent* cp = Canonical()->GetContentParent()) {
+      MaybeSetSHEntryHasUserInteraction(aLoadState);
+
       // Attempt to initiate this load immediately in the parent, if it
       // succeeds, aLoadState will have a reference to the pending
       // DocumentLoadListener, which will be recovered when the DocumentChannel
@@ -2446,6 +2448,32 @@ nsresult BrowsingContext::LoadURI(nsDocShellLoadState* aLoadState,
   return NS_OK;
 }
 
+void BrowsingContext::MaybeSetSHEntryHasUserInteraction(
+    const nsDocShellLoadState* aLoadState) {
+  // A system triggering principal means the load comes from browser chrome, so
+  // count it as user interaction for the entry we are leaving, to let the user
+  // navigate back to it.
+  nsIPrincipal* triggeringPrincipal = aLoadState->TriggeringPrincipal();
+  if (!triggeringPrincipal || !triggeringPrincipal->IsSystemPrincipal()) {
+    return;
+  }
+
+  WindowContext* topWc = GetTopWindowContext();
+  if (!topWc || topWc->IsDiscarded()) {
+    return;
+  }
+
+  // The parent process applies this to whichever session history entry is
+  // active when it arrives, so a content process setting it again for a load
+  // the parent already handled would race with the entry for the new load
+  // becoming the active one, and mark that entry instead.
+  if (topWc->GetSHEntryHasUserInteraction()) {
+    return;
+  }
+
+  MOZ_ALWAYS_SUCCEEDS(topWc->SetSHEntryHasUserInteraction(true));
+}
+
 nsresult BrowsingContext::InternalLoad(nsDocShellLoadState* aLoadState) {
   if (IsDiscarded()) {
     return NS_OK;
