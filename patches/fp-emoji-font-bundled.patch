 void gfxPlatformFontList::ResolveEmojiFontNames(
-    FontVisibilityProvider* aFontVisibilityProvider,
+    FontVisibilityProvider* aFontVisibilityProvider, bool aBundled,
     PrefFontList* aGenericFamilies) {
   // emoji preference has no lang name
   AutoTArray<nsCString, 4> genericFamilies;
 
   nsAutoCString value;
-  if (mFontPrefs->LookupNameList(PrefName("emoji", ""), value)) {
+  if (aBundled) {
+    // The emoji font the application ships, which renders the same whatever
+    // the OS and its version.
+    genericFamilies.AppendElement("Twemoji Mozilla"_ns);
+  } else if (mFontPrefs->LookupNameList(PrefName("emoji", ""), value)) {
     gfxFontUtils::ParseFontList(value, genericFamilies);
   }
 
@@ -2375,11 +2379,16 @@ gfxPlatformFontList::GetPrefFontsLangGroupLocked(
   if (aGenericType == StyleGenericFontFamily::MozEmoji ||
       aPrefLang == eFontPrefLang_Emoji) {
     // Emoji font has no lang
-    PrefFontList* prefFonts = mEmojiPrefFont.get();
+    const bool bundled = aFontVisibilityProvider &&
+                         aFontVisibilityProvider->ShouldResistFingerprinting(
+                             RFPTarget::EmojiFontBundled);
+    UniquePtr<PrefFontList>& cached =
+        bundled ? mBundledEmojiPrefFont : mEmojiPrefFont;
+    PrefFontList* prefFonts = cached.get();
     if (MOZ_UNLIKELY(!prefFonts)) {
       prefFonts = new PrefFontList;
-      ResolveEmojiFontNames(aFontVisibilityProvider, prefFonts);
-      mEmojiPrefFont.reset(prefFonts);
+      ResolveEmojiFontNames(aFontVisibilityProvider, bundled, prefFonts);
+      cached.reset(prefFonts);
     }
     return prefFonts;
   }
@@ -2986,6 +2995,7 @@ void gfxPlatformFontList::ClearLangGroupPrefFontsLocked() {
     }
   }
   mEmojiPrefFont = nullptr;
+  mBundledEmojiPrefFont = nullptr;
 
   // Create a new FontPrefs and replace the existing one.
   mFontPrefs = MakeUnique<FontPrefs>();
