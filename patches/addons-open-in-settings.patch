+    // Sval: extensions are managed in Settings.
+    const inSettings = ChromeUtils.importESModule(
+      "moz-src:///browser/components/sval/SvalAddonsNav.sys.mjs"
+    ).SvalAddonsNav.openInSettings(window, aView);
+    if (inSettings) {
+      return inSettings;
+    }
