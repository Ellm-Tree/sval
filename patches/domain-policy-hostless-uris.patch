@@ -1562,6 +1562,15 @@ NS_IMETHODIMP
 BasePrincipal::GetIsScriptAllowedByPolicy(bool* aIsScriptAllowedByPolicy) {
   AssertIsOnMainThread();
   *aIsScriptAllowedByPolicy = false;
+  // An opaque origin (a sandboxed frame, a data: document) answers as the
+  // principal that made it, so it cannot run script its maker may not.
+  if (Kind() == eNullPrincipal) {
+    nsCOMPtr<nsIPrincipal> precursor;
+    if (NS_SUCCEEDED(GetPrecursorPrincipal(getter_AddRefs(precursor))) &&
+        precursor) {
+      return precursor->GetIsScriptAllowedByPolicy(aIsScriptAllowedByPolicy);
+    }
+  }
   nsCOMPtr<nsIURI> prinURI;
   nsresult rv = GetURI(getter_AddRefs(prinURI));
   if (NS_FAILED(rv) || !prinURI) {
diff --git a/caps/DomainPolicy.cpp b/caps/DomainPolicy.cpp
index b0b6280b90..1b549417a1 100644
--- a/caps/DomainPolicy.cpp
+++ b/caps/DomainPolicy.cpp
@@ -130,12 +130,36 @@ void DomainPolicy::ApplyClone(const DomainPolicyClone* aClone) {
   CopyURIs(aClone->superAllowlist(), mSuperAllowlist);
 }
 
+// A URI with no host, such as a null principal's, names no domain, so it
+// belongs to no set.
+static bool HasHost(nsIURI* aURI) {
+  nsAutoCString host;
+  return NS_SUCCEEDED(aURI->GetHost(host)) && !host.IsEmpty();
+}
+
+// A domain is its scheme and host: the port and a trailing dot on the host
+// name the same domain.
 static already_AddRefed<nsIURI> GetCanonicalClone(nsIURI* aURI) {
   nsCOMPtr<nsIURI> clone;
-  nsresult rv =
-      NS_MutateURI(aURI).SetUserPass(""_ns).SetPathQueryRef(""_ns).Finalize(
-          clone);
-  NS_ENSURE_SUCCESS(rv, nullptr);
+  nsresult rv = NS_MutateURI(aURI)
+                    .SetUserPass(""_ns)
+                    .SetPort(-1)
+                    .SetPathQueryRef(""_ns)
+                    .Finalize(clone);
+  if (NS_FAILED(rv)) {
+    return nullptr;
+  }
+  nsAutoCString host;
+  if (NS_FAILED(clone->GetHost(host)) || host.IsEmpty()) {
+    return nullptr;
+  }
+  if (host.Last() == '.') {
+    host.Truncate(host.Length() - 1);
+    rv = NS_MutateURI(clone).SetHost(host).Finalize(clone);
+    if (NS_FAILED(rv)) {
+      return nullptr;
+    }
+  }
   return clone.forget();
 }
 
