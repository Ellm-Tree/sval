+void GetUserMediaWindowListener::StopSource(MediaSourceEnum aSource) {
+  MOZ_ASSERT(NS_IsMainThread(), "Only call on main thread");
+
+  for (auto& l : mActiveListeners.Clone()) {
+    if (l->GetDevice()->GetMediaSource() == aSource) {
+      l->Stop();
+    }
+  }
+}
