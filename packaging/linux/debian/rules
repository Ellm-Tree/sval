%:
	dh $@

override_dh_strip_nondeterminism:
	dh_strip_nondeterminism -Xxpi

override_dh_strip:
	:

# The repackager names the desktop entry after the package. Its file name is
# the application id the browser gives the desktop portal, notifications and
# MPRIS: the distribution id followed by the remoting name.
override_dh_install:
	dh_install
	mv debian/sval/usr/share/applications/sval.desktop \
		debian/sval/usr/share/applications/app.sval.sval.desktop
